<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Team Management - University Badminton</title>
    <link rel="icon" type="image/png" href="/assets/shuttlecock-favicon.png">
    <link rel="stylesheet" href="/css/team.css">
</head>
<body>
    <div class="container">
        <!-- Header -->
        <header class="header">
            <!-- Profile Button at Top -->
            <div class="header-top">
                <div class="profile-section">
                    <button class="btn-profile" id="profileButton">
                        <span class="profile-icon">👤</span>
                        <span class="profile-text">Profile</span>
                    </button>
                </div>
            </div>
            
            <!-- Header Content Below -->
            <div class="header-content">
                <div class="title-container">
                    <h1 class="header-title">
                        <span class="title-icon">🏸</span>
                        <span class="title-text">
                            <span class="title-line-1">TEAM</span>
                            <span class="title-line-2">MANAGEMENT</span>
                        </span>
                    </h1>
                </div>
                <p id="collegeName" class="college-name">-</p>
            </div>
        </header>

        <!-- Profile Popup -->
        <div id="profilePopup" class="profile-popup">
            <div class="profile-popup-content">
                <div class="profile-header">
                    <div class="profile-avatar">
                        <div class="avatar-circle">
                            <span class="avatar-icon">🎓</span>
                        </div>
                    </div>
                    <div class="profile-title">
                        <h3>College Profile</h3>
                        <p class="profile-subtitle">Team Management Dashboard</p>
                    </div>
                    <button class="close-profile" id="closeProfile">
                        <span>&times;</span>
                    </button>
                </div>
                
                <div class="profile-divider"></div>
                
                <div class="profile-body">
                    <div class="profile-info-card">
                        <div class="info-header">
                            <span class="info-icon">🏛️</span>
                            <h4>Institution Details</h4>
                        </div>
                        <div class="college-display">
                            <label>College Name</label>
                            <div class="college-name-container">
                                <p id="profileCollegeName" class="profile-college-name">-</p>
                                <span class="verified-badge">✓</span>
                            </div>
                        </div>
                    </div>
                    
                    <div class="profile-actions">
                        <button class="btn-change-password" id="changePasswordBtn">
                            <span class="btn-icon">�</span>
                            <div class="btn-content">
                                <span class="btn-title">Change Password</span>
                                <span class="btn-subtitle">Update your security credentials</span>
                            </div>
                            <span class="btn-arrow">→</span>
                        </button>
                        
                        <button class="btn-logout" id="logoutBtn">
                            <span class="btn-icon">🚪</span>
                            <div class="btn-content">
                                <span class="btn-title">Sign Out</span>
                                <span class="btn-subtitle">Return to homepage</span>
                            </div>
                            <span class="btn-arrow">→</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Login Section (if not logged in) -->
        <div id="loginSection" class="login-section" style="display: none;">
            <div class="login-card">
                <h2>College Login</h2>
                <form id="loginForm">
                    <div class="form-group">
                        <label for="email">College Email</label>
                        <input type="email" id="email" required placeholder="Enter your college email">
                    </div>
                    <button type="submit" class="btn-primary">Login</button>
                </form>
            </div>
        </div>

        <!-- Main Content (after login) -->
        <div id="mainContent" class="main-content" style="display: none;">
            
            <!-- Tab Navigation -->
            <div class="tab-nav">
                <button class="tab-btn active" data-tab="matches">My Matches</button>
                <button class="tab-btn" data-tab="players">Players</button>
            </div>

            <!-- Matches Tab -->
            <div id="matchesTab" class="tab-content active">
                <!-- Gender Tabs for Matches -->
                <div class="match-gender-tabs">
                    <button class="match-tab-btn active" data-gender="boys">Boys Matches</button>
                    <button class="match-tab-btn" data-gender="girls">Girls Matches</button>
                </div>

                <!-- Filter Section -->
                <div class="filter-section">
                    <div class="filter-tabs">
                        <button class="filter-btn active" data-filter="all">All</button>
                        <button class="filter-btn" data-filter="live">Live</button>
                        <button class="filter-btn" data-filter="upcoming">Upcoming</button>
                        <button class="filter-btn" data-filter="complete">Complete</button>
                    </div>
                </div>

                <!-- Loading -->
                <div id="matchesLoading" class="loading">Loading matches...</div>

                <!-- Matches Container -->
                <div id="matchesContainer" class="matches-container"></div>

                <!-- No Matches -->
                <div id="noMatches" class="no-matches" style="display: none;">
                    <p>No matches found</p>
                </div>
            </div>

            <!-- Players Tab -->
            <div id="playersTab" class="tab-content">
                <!-- Add Player Button -->
                <div class="players-header">
                    <h2>Team Players</h2>
                    <button class="btn-primary" onclick="openAddPlayerModal()">+ Add Player</button>
                </div>

                <!-- Gender Filter for Players -->
                <div class="player-gender-tabs">
                    <button class="player-tab-btn active" data-gender="boys">Boys Team</button>
                    <button class="player-tab-btn" data-gender="girls">Girls Team</button>
                </div>

                <!-- Players Loading -->
                <div id="playersLoading" class="loading">Loading players...</div>

                <!-- Players Container -->
                <div id="playersContainer" class="players-container"></div>

                <!-- No Players -->
                <div id="noPlayers" class="no-players" style="display: none;">
                    <p>No players added yet</p>
                </div>
            </div>

        </div>
    </div>

    <!-- Add Player Modal -->
    <div id="addPlayerModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h2>Add New Player</h2>
                <span class="close" onclick="closeAddPlayerModal()">&times;</span>
            </div>
            <form id="addPlayerForm">
                <div class="form-group">
                    <label for="playerName">Player Name *</label>
                    <input type="text" id="playerName" required placeholder="Enter player name">
                </div>
                <div class="form-group">
                    <label for="playerEmail">Email *</label>
                    <input type="email" id="playerEmail" required placeholder="Enter player email">
                </div>
                <div class="form-group">
                    <label for="playerGender">Gender *</label>
                    <select id="playerGender" required>
                        <option value="">Select Gender</option>
                        <option value="male">Male</option>
                        <option value="female">Female</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="playerPhone">Phone</label>
                    <input type="tel" id="playerPhone" placeholder="Enter phone number">
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-secondary" onclick="closeAddPlayerModal()">Cancel</button>
                    <button type="submit" class="btn-primary">Add Player</button>
                </div>
            </form>
        </div>
    </div>

    <script src="/js/team.js"></script>
</body>
</html>
