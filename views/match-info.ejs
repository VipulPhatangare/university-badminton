<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Match Info - Badminton Tournament</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
        }
        
        .container {
            max-width: 1200px;
            margin: 0 auto;
            background: white;
            border-radius: 15px;
            padding: 30px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
        }
        
        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
            border-bottom: 2px solid #f0f0f0;
            padding-bottom: 20px;
        }
        
        h1 {
            color: #333;
            font-size: 2rem;
        }
        
        .btn {
            padding: 12px 24px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-weight: 600;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-block;
        }
        
        .btn-primary {
            background: #007bff;
            color: white;
        }
        
        .btn-primary:hover {
            background: #0056b3;
            transform: translateY(-2px);
        }
        
        .btn-success {
            background: #28a745;
            color: white;
        }
        
        .btn-success:hover {
            background: #1e7e34;
        }
        
        .btn-secondary {
            background: #6c757d;
            color: white;
        }
        
        .btn-secondary:hover {
            background: #545b62;
        }
        
        .match-card {
            background: white;
            border-radius: 12px;
            padding: 25px;
            margin-bottom: 20px;
            border: 1px solid #e0e0e0;
        }
        
        .match-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }
        
        .match-header h2 {
            color: #333;
            font-size: 1.5rem;
        }
        
        .match-status {
            padding: 8px 16px;
            border-radius: 20px;
            font-weight: bold;
            text-transform: uppercase;
            font-size: 0.8rem;
        }
        
        .upcoming {
            background: #e3f2fd;
            color: #1976d2;
        }
        
        .live {
            background: #e8f5e8;
            color: #388e3c;
        }
        
        .complete {
            background: #fce4ec;
            color: #c2185b;
        }
        
        .match-details {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 15px;
            margin: 20px 0;
            padding: 20px;
            background: #f8f9fa;
            border-radius: 8px;
        }
        
        .detail-item {
            text-align: center;
        }
        
        .detail-label {
            font-weight: bold;
            color: #666;
            font-size: 0.9rem;
            margin-bottom: 5px;
        }
        
        .detail-value {
            font-size: 1.1rem;
            color: #333;
        }
        
        .referee-section {
            background: #fff3cd;
            border: 1px solid #ffeaa7;
            border-radius: 8px;
            padding: 20px;
            margin: 20px 0;
        }
        
        .referee-section h3 {
            color: #856404;
            margin-bottom: 15px;
        }
        
        .referee-assignment {
            display: grid;
            grid-template-columns: 1fr auto;
            gap: 15px;
            align-items: center;
        }
        
        .current-referees {
            background: #d4edda;
            border: 1px solid #c3e6cb;
            border-radius: 8px;
            padding: 15px;
            margin-bottom: 15px;
        }
        
        .current-referees h4 {
            color: #155724;
            margin-bottom: 10px;
        }
        
        .referee-list {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }
        
        .referee-tag {
            background: #28a745;
            color: white;
            padding: 5px 12px;
            border-radius: 15px;
            font-size: 0.9rem;
        }
        
        .form-control {
            width: 100%;
            padding: 12px;
            border: 1px solid #ccc;
            border-radius: 6px;
            font-size: 1rem;
        }
        
        .form-control:focus {
            outline: none;
            border-color: #007bff;
            box-shadow: 0 0 0 3px rgba(0,123,255,0.1);
        }
        
        .player-allocation {
            background: #f8f9fa;
            border-radius: 12px;
            padding: 25px;
            margin: 20px 0;
        }
        
        .match-section {
            background: white;
            border-radius: 8px;
            padding: 20px;
            margin: 15px 0;
            border: 1px solid #e0e0e0;
        }
        
        .match-section h4 {
            color: #007bff;
            margin-bottom: 15px;
            font-size: 1.2rem;
        }
        
        .team-selection {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }
        
        .team-section {
            background: #f1f3f4;
            padding: 15px;
            border-radius: 8px;
        }
        
        .team-section h5 {
            color: #333;
            margin-bottom: 15px;
            text-align: center;
        }
        
        .player-select {
            margin-bottom: 10px;
        }
        
        .confirmation-actions {
            text-align: center;
            margin-top: 30px;
            padding-top: 20px;
            border-top: 2px solid #f0f0f0;
        }
        
        .progress-indicator {
            display: flex;
            justify-content: center;
            margin: 30px 0;
        }
        
        .progress-step {
            padding: 10px 20px;
            margin: 0 5px;
            border-radius: 20px;
            background: #e9ecef;
            color: #6c757d;
            font-weight: 500;
        }
        
        .progress-step.active {
            background: #007bff;
            color: white;
        }
        
        .allocated-players {
            background: #d4edda;
            border: 1px solid #c3e6cb;
            border-radius: 8px;
            padding: 20px;
            margin: 20px 0;
        }
        
        .allocated-players h3 {
            color: #155724;
            margin-bottom: 15px;
        }
        
        .match-summary {
            padding: 10px 0;
            border-bottom: 1px solid #c3e6cb;
        }
        
        .match-summary:last-child {
            border-bottom: none;
        }
        
        .match-summary h4 {
            color: #155724;
            font-size: 1rem;
            margin-bottom: 5px;
        }
        
        .alert {
            padding: 15px;
            border-radius: 8px;
            margin: 10px 0;
        }
        
        .alert-success {
            background: #d4edda;
            border: 1px solid #c3e6cb;
            color: #155724;
        }
        
        .alert-warning {
            background: #fff3cd;
            border: 1px solid #ffeaa7;
            color: #856404;
        }
        
        @media (max-width: 768px) {
            .container {
                padding: 15px;
            }
            
            header {
                flex-direction: column;
                gap: 15px;
            }
            
            .team-selection {
                grid-template-columns: 1fr;
                gap: 15px;
            }
            
            .referee-assignment {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <header>
            <h1>Match Information & Management</h1>
            <button onclick="goBack()" class="btn btn-primary">← Back to Dashboard</button>
        </header>

        <div class="progress-indicator">
            <div class="progress-step active" id="step1">Match Info</div>
            <div class="progress-step" id="step2">Referee Assignment</div>
            <div class="progress-step" id="step3">Player Allocation</div>
            <div class="progress-step" id="step4">Ready to Start</div>
        </div>
        
        <div class="match-card">
            <div class="match-header">
                <h2><%= match.college1Name %> vs <%= match.college2Name %></h2>
                <span class="match-status <%= match.matchStatus %>"><%= match.matchStatus %></span>
            </div>
            
            <div class="match-details">
                <div class="detail-item">
                    <div class="detail-label">Date</div>
                    <div class="detail-value"><%= match.date %></div>
                </div>
                <div class="detail-item">
                    <div class="detail-label">Time</div>
                    <div class="detail-value"><%= match.time %></div>
                </div>
                <div class="detail-item">
                    <div class="detail-label">Court</div>
                    <div class="detail-value"><%= match.court || 'TBD' %></div>
                </div>
                <div class="detail-item">
                    <div class="detail-label">Round</div>
                    <div class="detail-value"><%= match.round || 'Group Stage' %></div>
                </div>
            </div>

            <!-- Current Referees Section -->
            <div class="current-referees">
                <h4>Assigned Referees</h4>
                <div class="referee-list" id="currentRefereesList">
                    <% if (match.refreeName) { %>
                        <span class="referee-tag">Main: <%= match.refreeName %></span>
                    <% } %>
                    <!-- Additional referees will be added here -->
                </div>
            </div>

            <!-- Referee Assignment Section -->
            <div class="referee-section">
                <h3>Assign Additional Referee</h3>
                <div class="referee-assignment">
                    <select id="refereeSelect" class="form-control">
                        <option value="">Select a referee to assign</option>
                        <!-- Options will be populated by JavaScript -->
                    </select>
                    <button onclick="assignReferee()" class="btn btn-success">Assign Referee</button>
                </div>
            </div>

            <!-- Player Allocation Section -->
            <div class="player-allocation">
                <h3>Player Allocation (5-Match System)</h3>
                <div class="alert alert-warning">
                    <strong>Tournament Format:</strong> First team to win 3 out of 5 matches wins overall
                </div>
                
                <!-- Singles Match 1 -->
                <div class="match-section">
                    <h4>Match 1 - Singles</h4>
                    <div class="team-selection">
                        <div class="team-section">
                            <h5><%= match.college1Name %></h5>
                            <select id="match1_player1" class="form-control">
                                <option value="">Select Player</option>
                            </select>
                        </div>
                        <div class="team-section">
                            <h5><%= match.college2Name %></h5>
                            <select id="match1_player2" class="form-control">
                                <option value="">Select Player</option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- Singles Match 2 -->
                <div class="match-section">
                    <h4>Match 2 - Singles</h4>
                    <div class="team-selection">
                        <div class="team-section">
                            <h5><%= match.college1Name %></h5>
                            <select id="match2_player1" class="form-control">
                                <option value="">Select Player</option>
                            </select>
                        </div>
                        <div class="team-section">
                            <h5><%= match.college2Name %></h5>
                            <select id="match2_player2" class="form-control">
                                <option value="">Select Player</option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- Doubles Match 3 -->
                <div class="match-section">
                    <h4>Match 3 - Doubles</h4>
                    <div class="team-selection">
                        <div class="team-section">
                            <h5><%= match.college1Name %></h5>
                            <div class="player-select">
                                <select id="match3_team1_player1" class="form-control">
                                    <option value="">Select Player 1</option>
                                </select>
                            </div>
                            <div class="player-select">
                                <select id="match3_team1_player2" class="form-control">
                                    <option value="">Select Player 2</option>
                                </select>
                            </div>
                        </div>
                        <div class="team-section">
                            <h5><%= match.college2Name %></h5>
                            <div class="player-select">
                                <select id="match3_team2_player1" class="form-control">
                                    <option value="">Select Player 1</option>
                                </select>
                            </div>
                            <div class="player-select">
                                <select id="match3_team2_player2" class="form-control">
                                    <option value="">Select Player 2</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Singles Match 4 -->
                <div class="match-section">
                    <h4>Match 4 - Singles</h4>
                    <div class="team-selection">
                        <div class="team-section">
                            <h5><%= match.college1Name %></h5>
                            <select id="match4_player1" class="form-control">
                                <option value="">Select Player</option>
                            </select>
                        </div>
                        <div class="team-section">
                            <h5><%= match.college2Name %></h5>
                            <select id="match4_player2" class="form-control">
                                <option value="">Select Player</option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- Doubles Match 5 -->
                <div class="match-section">
                    <h4>Match 5 - Doubles</h4>
                    <div class="team-selection">
                        <div class="team-section">
                            <h5><%= match.college1Name %></h5>
                            <div class="player-select">
                                <select id="match5_team1_player1" class="form-control">
                                    <option value="">Select Player 1</option>
                                </select>
                            </div>
                            <div class="player-select">
                                <select id="match5_team1_player2" class="form-control">
                                    <option value="">Select Player 2</option>
                                </select>
                            </div>
                        </div>
                        <div class="team-section">
                            <h5><%= match.college2Name %></h5>
                            <div class="player-select">
                                <select id="match5_team2_player1" class="form-control">
                                    <option value="">Select Player 1</option>
                                </select>
                            </div>
                            <div class="player-select">
                                <select id="match5_team2_player2" class="form-control">
                                    <option value="">Select Player 2</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Show allocated players if already set -->
            <div id="allocatedPlayersSection" class="allocated-players" style="display: none;">
                <h3>Current Player Allocations</h3>
                <div id="allocatedPlayersList"></div>
            </div>
            
            <div class="confirmation-actions">
                <button onclick="savePlayerAllocations()" class="btn btn-success" id="saveBtn">Save Player Allocations</button>
                <button onclick="confirmAndProceed()" class="btn btn-primary" id="proceedBtn" style="display: none;">Proceed to Scorecard</button>
            </div>
        </div>
    </div>

    <script>
        // Initialize match data safely using a different approach
        window.matchDataString = `<%- JSON.stringify(match) %>`;
        let matchData = {};
        
        try {
            matchData = JSON.parse(window.matchDataString);
        } catch (e) {
            console.error('Error parsing match data:', e);
            // Fallback to individual fields
            matchData = {
                _id: "<%= match._id || '' %>",
                college1Name: "<%= match.college1Name || '' %>",
                college2Name: "<%= match.college2Name || '' %>",
                email1: "<%= match.email1 || '' %>",
                email2: "<%= match.email2 || '' %>",
                date: "<%= match.date || '' %>",
                time: "<%= match.time || '' %>",
                court: "<%= match.court || '' %>",
                round: "<%= match.round || '' %>",
                matchStatus: "<%= match.matchStatus || 'upcoming' %>",
                refreeEmail: "<%= match.refreeEmail || '' %>",
                refreeName: "<%= match.refreeName || '' %>",
                refreeId: [],
                match1Singles: null,
                match2Singles: null,
                match3Doubles: null,
                match4Singles: null,
                match5Doubles: null,
                matchResults: [],
                completedMatches: 0,
                overallWinner: ""
            };
        }

        let college1Players = [];
        let college2Players = [];
        let availableReferees = [];
        let assignedReferees = [];

        // Initialize the page
        document.addEventListener('DOMContentLoaded', function() {
            setProgressStep(1);
            loadPlayers();
            loadReferees();
            loadAssignedReferees();
            checkExistingAllocations();
        });

        async function loadPlayers() {
            try {
                console.log('Loading players for colleges:', matchData.email1, 'and', matchData.email2);
                
                // Load players for college 1 (boys players only for badminton)
                const response1 = await fetch(`/api/admin/players?college=${encodeURIComponent(matchData.email1)}&gender=male`);
                console.log('College 1 response status:', response1.status);
                if (response1.ok) {
                    college1Players = await response1.json();
                    console.log('College 1 players:', college1Players);
                } else {
                    console.error('Failed to load college 1 players:', response1.status, await response1.text());
                }
                
                // Load players for college 2 (boys players only for badminton)
                const response2 = await fetch(`/api/admin/players?college=${encodeURIComponent(matchData.email2)}&gender=male`);
                console.log('College 2 response status:', response2.status);
                if (response2.ok) {
                    college2Players = await response2.json();
                    console.log('College 2 players:', college2Players);
                } else {
                    console.error('Failed to load college 2 players:', response2.status, await response2.text());
                }
                
                populatePlayerDropdowns();
                addPlayerSelectionListeners();
            } catch (error) {
                console.error('Error loading players:', error);
                alert('Error loading player data');
            }
        }

        async function loadReferees() {
            try {
                console.log('Loading referees...');
                const response = await fetch('/api/admin/referees');
                console.log('Referees response status:', response.status);
                if (response.ok) {
                    availableReferees = await response.json();
                    console.log('Available referees:', availableReferees);
                    populateRefereeDropdown();
                } else {
                    console.error('Failed to load referees:', await response.text());
                }
            } catch (error) {
                console.error('Error loading referees:', error);
            }
        }

        async function loadAssignedReferees() {
            try {
                // For now, just load from match data until we have proper assigned referee endpoints
                assignedReferees = matchData.assignedRefereeNames ? 
                    matchData.assignedRefereeNames.map(name => ({ name, refEmail: '' })) : [];
                updateAssignedRefereesList();
            } catch (error) {
                console.error('Error loading assigned referees:', error);
            }
        }

        function populateRefereeDropdown() {
            const select = document.getElementById('refereeSelect');
            select.innerHTML = '<option value="">Select a referee to assign</option>';
            
            availableReferees.forEach(referee => {
                // Don't include current main referee or already assigned referees
                if (referee.refEmail !== matchData.refreeEmail && 
                    !assignedReferees.some(ar => ar.refEmail === referee.refEmail)) {
                    const option = document.createElement('option');
                    option.value = referee.refEmail;
                    option.textContent = `${referee.name} (${referee.refEmail})`;
                    select.appendChild(option);
                }
            });
        }

        function updateAssignedRefereesList() {
            const list = document.getElementById('currentRefereesList');
            // Keep main referee, add assigned ones
            let html = '<span class="referee-tag">Main: ' + (matchData.refreeName || 'Not Set') + '</span>';
            
            assignedReferees.forEach(referee => {
                html += `<span class="referee-tag">Assistant: ${referee.name}</span>`;
            });
            
            list.innerHTML = html;
        }

        function getSelectedPlayers() {
            const selectedPlayers = {
                college1: [],
                college2: []
            };
            
            // Get all selected players for college 1
            const college1Selects = [
                'match1_player1', 'match2_player1', 'match4_player1',
                'match3_team1_player1', 'match3_team1_player2', 
                'match5_team1_player1', 'match5_team1_player2'
            ];
            
            // Get all selected players for college 2
            const college2Selects = [
                'match1_player2', 'match2_player2', 'match4_player2',
                'match3_team2_player1', 'match3_team2_player2', 
                'match5_team2_player1', 'match5_team2_player2'
            ];
            
            college1Selects.forEach(selectId => {
                const select = document.getElementById(selectId);
                if (select && select.value) {
                    try {
                        const playerData = JSON.parse(select.value);
                        selectedPlayers.college1.push(playerData.email);
                    } catch (e) {
                        // Ignore parsing errors
                    }
                }
            });
            
            college2Selects.forEach(selectId => {
                const select = document.getElementById(selectId);
                if (select && select.value) {
                    try {
                        const playerData = JSON.parse(select.value);
                        selectedPlayers.college2.push(playerData.email);
                    } catch (e) {
                        // Ignore parsing errors
                    }
                }
            });
            
            return selectedPlayers;
        }

        function populatePlayerDropdowns() {
            populateSpecificDropdown('match1_player1', college1Players, 'college1');
            populateSpecificDropdown('match1_player2', college2Players, 'college2');
            populateSpecificDropdown('match2_player1', college1Players, 'college1');
            populateSpecificDropdown('match2_player2', college2Players, 'college2');
            populateSpecificDropdown('match3_team1_player1', college1Players, 'college1');
            populateSpecificDropdown('match3_team1_player2', college1Players, 'college1');
            populateSpecificDropdown('match3_team2_player1', college2Players, 'college2');
            populateSpecificDropdown('match3_team2_player2', college2Players, 'college2');
            populateSpecificDropdown('match4_player1', college1Players, 'college1');
            populateSpecificDropdown('match4_player2', college2Players, 'college2');
            populateSpecificDropdown('match5_team1_player1', college1Players, 'college1');
            populateSpecificDropdown('match5_team1_player2', college1Players, 'college1');
            populateSpecificDropdown('match5_team2_player1', college2Players, 'college2');
            populateSpecificDropdown('match5_team2_player2', college2Players, 'college2');
        }

        function populateSpecificDropdown(selectId, players, collegeType) {
            const select = document.getElementById(selectId);
            if (!select) return;
            
            const currentValue = select.value; // Preserve current selection
            const selectedPlayers = getSelectedPlayers();
            
            select.innerHTML = '<option value="">Select Player</option>';
            
            players.forEach(player => {
                const playerEmail = player.email;
                const isAlreadySelected = selectedPlayers[collegeType].includes(playerEmail);
                const isCurrentSelection = currentValue && JSON.parse(currentValue).email === playerEmail;
                
                // Show player if not selected elsewhere OR if it's the current selection
                if (!isAlreadySelected || isCurrentSelection) {
                    const option = document.createElement('option');
                    option.value = JSON.stringify({name: player.name || player.playerName, email: player.email});
                    option.textContent = player.name || player.playerName;
                    
                    // Restore previous selection
                    if (isCurrentSelection) {
                        option.selected = true;
                    }
                    
                    select.appendChild(option);
                }
            });
        }

        // Add event listeners to all dropdowns to refresh options when selection changes
        function addPlayerSelectionListeners() {
            const allSelects = [
                'match1_player1', 'match1_player2',
                'match2_player1', 'match2_player2',
                'match3_team1_player1', 'match3_team1_player2', 
                'match3_team2_player1', 'match3_team2_player2',
                'match4_player1', 'match4_player2',
                'match5_team1_player1', 'match5_team1_player2', 
                'match5_team2_player1', 'match5_team2_player2'
            ];
            
            allSelects.forEach(selectId => {
                const select = document.getElementById(selectId);
                if (select) {
                    select.addEventListener('change', function() {
                        // Refresh all dropdowns when any selection changes
                        populatePlayerDropdowns();
                    });
                }
            });
        }

        async function assignReferee() {
            const selectedReferee = document.getElementById('refereeSelect').value;
            if (!selectedReferee) {
                alert('Please select a referee to assign');
                return;
            }

            try {
                // For now, just add to local list and show success
                // In a full implementation, this would make an API call to update the match
                const referee = availableReferees.find(r => r.refEmail === selectedReferee);
                if (referee) {
                    assignedReferees.push({ name: referee.name, refEmail: referee.refEmail });
                    updateAssignedRefereesList();
                    populateRefereeDropdown(); // Update dropdown to remove assigned referee
                    setProgressStep(2);
                    alert('Referee assigned successfully!');
                }
            } catch (error) {
                console.error('Error assigning referee:', error);
                alert('Error assigning referee');
            }
        }

        function checkExistingAllocations() {
            if (matchData.match1Singles && matchData.match1Singles.player1Name) {
                showAllocatedPlayers();
                document.querySelector('.player-allocation').style.display = 'none';
                document.getElementById('saveBtn').style.display = 'none';
                document.getElementById('proceedBtn').style.display = 'inline-block';
                setProgressStep(4);
            }
        }

        function showAllocatedPlayers() {
            const section = document.getElementById('allocatedPlayersSection');
            const list = document.getElementById('allocatedPlayersList');
            
            let html = '';
            html += '<div class="match-summary"><h4>Match 1 - Singles</h4>';
            html += `<p>${matchData.match1Singles.player1Name} vs ${matchData.match1Singles.player2Name}</p></div>`;
            
            html += '<div class="match-summary"><h4>Match 2 - Singles</h4>';
            html += `<p>${matchData.match2Singles.player1Name} vs ${matchData.match2Singles.player2Name}</p></div>`;
            
            html += '<div class="match-summary"><h4>Match 3 - Doubles</h4>';
            html += `<p>${matchData.match3Doubles.team1Player1Name} & ${matchData.match3Doubles.team1Player2Name} vs ${matchData.match3Doubles.team2Player1Name} & ${matchData.match3Doubles.team2Player2Name}</p></div>`;
            
            html += '<div class="match-summary"><h4>Match 4 - Singles</h4>';
            html += `<p>${matchData.match4Singles.player1Name} vs ${matchData.match4Singles.player2Name}</p></div>`;
            
            html += '<div class="match-summary"><h4>Match 5 - Doubles</h4>';
            html += `<p>${matchData.match5Doubles.team1Player1Name} & ${matchData.match5Doubles.team1Player2Name} vs ${matchData.match5Doubles.team2Player1Name} & ${matchData.match5Doubles.team2Player2Name}</p></div>`;
            
            list.innerHTML = html;
            section.style.display = 'block';
        }

        async function savePlayerAllocations() {
            if (!validatePlayerSelections()) {
                return;
            }

            const playerData = {
                match1Singles: {
                    player1Name: JSON.parse(document.getElementById('match1_player1').value).name,
                    player1Email: JSON.parse(document.getElementById('match1_player1').value).email,
                    player2Name: JSON.parse(document.getElementById('match1_player2').value).name,
                    player2Email: JSON.parse(document.getElementById('match1_player2').value).email
                },
                match2Singles: {
                    player1Name: JSON.parse(document.getElementById('match2_player1').value).name,
                    player1Email: JSON.parse(document.getElementById('match2_player1').value).email,
                    player2Name: JSON.parse(document.getElementById('match2_player2').value).name,
                    player2Email: JSON.parse(document.getElementById('match2_player2').value).email
                },
                match3Doubles: {
                    team1Player1Name: JSON.parse(document.getElementById('match3_team1_player1').value).name,
                    team1Player1Email: JSON.parse(document.getElementById('match3_team1_player1').value).email,
                    team1Player2Name: JSON.parse(document.getElementById('match3_team1_player2').value).name,
                    team1Player2Email: JSON.parse(document.getElementById('match3_team1_player2').value).email,
                    team2Player1Name: JSON.parse(document.getElementById('match3_team2_player1').value).name,
                    team2Player1Email: JSON.parse(document.getElementById('match3_team2_player1').value).email,
                    team2Player2Name: JSON.parse(document.getElementById('match3_team2_player2').value).name,
                    team2Player2Email: JSON.parse(document.getElementById('match3_team2_player2').value).email
                },
                match4Singles: {
                    player1Name: JSON.parse(document.getElementById('match4_player1').value).name,
                    player1Email: JSON.parse(document.getElementById('match4_player1').value).email,
                    player2Name: JSON.parse(document.getElementById('match4_player2').value).name,
                    player2Email: JSON.parse(document.getElementById('match4_player2').value).email
                },
                match5Doubles: {
                    team1Player1Name: JSON.parse(document.getElementById('match5_team1_player1').value).name,
                    team1Player1Email: JSON.parse(document.getElementById('match5_team1_player1').value).email,
                    team1Player2Name: JSON.parse(document.getElementById('match5_team1_player2').value).name,
                    team1Player2Email: JSON.parse(document.getElementById('match5_team1_player2').value).email,
                    team2Player1Name: JSON.parse(document.getElementById('match5_team2_player1').value).name,
                    team2Player1Email: JSON.parse(document.getElementById('match5_team2_player1').value).email,
                    team2Player2Name: JSON.parse(document.getElementById('match5_team2_player2').value).name,
                    team2Player2Email: JSON.parse(document.getElementById('match5_team2_player2').value).email
                }
            };

            try {
                const response = await fetch(`/api/admin/match/${matchData._id}/complete-setup`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        matchConfigs: {},
                        playerAllocations: playerData
                    })
                });

                const result = await response.json();
                if (result.success) {
                    alert('Player allocations saved successfully!');
                    setProgressStep(4);
                    document.querySelector('.player-allocation').style.display = 'none';
                    document.getElementById('saveBtn').style.display = 'none';
                    document.getElementById('proceedBtn').style.display = 'inline-block';
                    
                    Object.assign(matchData, playerData);
                    showAllocatedPlayers();
                } else {
                    alert('Error saving player allocations: ' + result.message);
                }
            } catch (error) {
                console.error('Error saving player allocations:', error);
                alert('Error saving player allocations');
            }
        }

        function validatePlayerSelections() {
            const requiredSelects = [
                'match1_player1', 'match1_player2',
                'match2_player1', 'match2_player2',
                'match3_team1_player1', 'match3_team1_player2', 'match3_team2_player1', 'match3_team2_player2',
                'match4_player1', 'match4_player2',
                'match5_team1_player1', 'match5_team1_player2', 'match5_team2_player1', 'match5_team2_player2'
            ];

            for (let selectId of requiredSelects) {
                const select = document.getElementById(selectId);
                if (!select.value) {
                    alert(`Please select all players. Missing: ${selectId.replace(/_/g, ' ')}`);
                    select.focus();
                    return false;
                }
            }

            // Check for duplicate player selections
            const selectedPlayers = [];
            for (let selectId of requiredSelects) {
                const value = document.getElementById(selectId).value;
                if (value) {
                    const player = JSON.parse(value);
                    if (selectedPlayers.includes(player.email)) {
                        alert(`Player ${player.name} is selected multiple times. Each player can only play in one match.`);
                        return false;
                    }
                    selectedPlayers.push(player.email);
                }
            }

            return true;
        }

        function confirmAndProceed() {
            if (confirm('Are you sure you want to proceed to the scorecard? This will start the tournament matches.')) {
                // For now, redirect to matches page since scorecard might not exist yet
                window.location.href = `/match/${matchData._id}`;
            }
        }

        function setProgressStep(step) {
            document.querySelectorAll('.progress-step').forEach((el, index) => {
                if (index + 1 <= step) {
                    el.classList.add('active');
                } else {
                    el.classList.remove('active');
                }
            });
        }

        function goBack() {
            if (confirm('Are you sure you want to go back? Any unsaved changes will be lost.')) {
                window.location.href = '/admin';
            }
        }
    </script>
</body>
</html>