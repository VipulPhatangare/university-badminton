<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Match Details - University Badminton Championship</title>
    <link rel="stylesheet" href="/css/match-detail.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
    <!-- Navigation Bar -->
    <nav class="navbar">
        <div class="nav-container">
            <div class="nav-brand">
                <span class="brand-icon">🏸</span>
                <span class="brand-text">University Badminton</span>
            </div>
            <button class="nav-back-btn" onclick="window.location.href='/matches'">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M19 12H5M12 19l-7-7 7-7"/>
                </svg>
                Back to Matches
            </button>
        </div>
    </nav>

    <div class="container">
        <!-- Match Header Section -->
        <div class="match-header-section" id="matchHeader">
            <div class="match-title-wrapper">
                <div class="match-type-badge">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"/>
                        <path d="M12 6v6l4 2"/>
                    </svg>
                    <span>Inter-College Championship</span>
                </div>
                <h1 class="match-title">
                    <span id="college1Name" class="team-name">Loading...</span>
                    <span class="vs-text">VS</span>
                    <span id="college2Name" class="team-name">Loading...</span>
                </h1>
                <div class="match-meta-info">
                    <div class="meta-item">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                            <line x1="16" y1="2" x2="16" y2="6"/>
                            <line x1="8" y1="2" x2="8" y2="6"/>
                            <line x1="3" y1="10" x2="21" y2="10"/>
                        </svg>
                        <span id="matchDate">-</span>
                    </div>
                    <div class="meta-item">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"/>
                            <polyline points="12 6 12 12 16 14"/>
                        </svg>
                        <span id="matchTime">-</span>
                    </div>
                    <div class="meta-item status-badge" id="matchStatus">
                        <span class="status-dot"></span>
                        <span class="status-text">Loading...</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Overall Score -->
        <div class="overall-score-card" id="overallScoreContainer">
            <h2 class="section-title">Match Score</h2>
            <div class="score-display-wrapper">
                <div class="team-score-card">
                    <div class="team-badge">
                        <div class="team-icon">🏆</div>
                    </div>
                    <h3 class="team-display-name" id="team1Name">Team 1</h3>
                    <div class="score-number" id="team1Score">0</div>
                    <span class="score-label">Matches Won</span>
                </div>
                
                <div class="score-divider">
                    <div class="divider-line"></div>
                    <span class="vs-badge">VS</span>
                    <div class="divider-line"></div>
                </div>
                
                <div class="team-score-card">
                    <div class="team-badge">
                        <div class="team-icon">🏆</div>
                    </div>
                    <h3 class="team-display-name" id="team2Name">Team 2</h3>
                    <div class="score-number" id="team2Score">0</div>
                    <span class="score-label">Matches Won</span>
                </div>
            </div>
        </div>

        <!-- Referee Info -->
        <div class="info-card referee-card" id="refereeInfo">
            <div class="info-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                    <circle cx="12" cy="7" r="4"/>
                </svg>
            </div>
            <div class="info-content">
                <span class="info-label">Match Referee</span>
                <span class="info-value" id="refereeName">-</span>
            </div>
        </div>

        <!-- Sub-matches Container -->
        <div class="submatches-section" id="submatchesContainer">
            <div class="section-header">
                <h2 class="section-title">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="3" width="7" height="7"/>
                        <rect x="14" y="3" width="7" height="7"/>
                        <rect x="14" y="14" width="7" height="7"/>
                        <rect x="3" y="14" width="7" height="7"/>
                    </svg>
                    Match Breakdown
                </h2>
                <p class="section-subtitle">View detailed results for each singles and doubles match</p>
            </div>
            <div class="matches-grid" id="matchesList">
                <!-- Singles and Doubles matches will be listed here -->
            </div>
        </div>

        <!-- Loading Spinner -->
        <div class="loading-overlay" id="loading">
            <div class="loading-content">
                <div class="spinner-modern"></div>
                <p class="loading-text">Loading match details...</p>
            </div>
        </div>
    </div>

    <!-- Popup Modal for Individual Match Details -->
    <div id="matchPopup" class="modal-overlay">
        <div class="modal-container">
            <button class="modal-close-btn" onclick="closePopup()" aria-label="Close">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="18" y1="6" x2="6" y2="18"/>
                    <line x1="6" y1="6" x2="18" y2="18"/>
                </svg>
            </button>
            
            <div class="modal-header" id="popupHeader">
                <div class="modal-badge" id="popupMatchType">Singles</div>
                <h2 class="modal-title" id="popupMatchTitle">Match Details</h2>
            </div>

            <div class="modal-players-section" id="popupPlayers">
                <!-- Player names will be shown here -->
            </div>

            <div class="modal-score-grid" id="popupScoreSection">
                <!-- Score cards will be displayed here -->
            </div>

            <!-- Tabs for Summary and History -->
            <div class="modal-tabs">
                <button class="modal-tab-btn active" onclick="switchPopupTab('summary')">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="3" width="7" height="7"/>
                        <rect x="14" y="3" width="7" height="7"/>
                        <rect x="14" y="14" width="7" height="7"/>
                        <rect x="3" y="14" width="7" height="7"/>
                    </svg>
                    Summary
                </button>
                <button class="modal-tab-btn" onclick="switchPopupTab('history')">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/>
                        <polyline points="17 6 23 6 23 12"/>
                    </svg>
                    Match History
                </button>
            </div>

            <!-- Tab Content -->
            <div class="modal-content-area">
                <div class="modal-tab-pane active" id="popupSummaryTab">
                    <div class="modal-score-table" id="popupScoreTable">
                        <!-- Score summary will be displayed here -->
                    </div>
                </div>

                <div class="modal-tab-pane" id="popupHistoryTab">
                    <div class="modal-history-list" id="popupPointHistory">
                        <!-- Point by point history will be displayed here -->
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Pass match ID from server to JavaScript
        const matchId = '<%= matchId %>';
    </script>
    <script src="/js/matches.js"></script>
    <script src="/js/match-detail.js"></script>
</body>
</html>
