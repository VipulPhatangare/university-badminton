<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Referee Dashboard - Inter Collegiate Badminton Competition</title>
    <link rel="icon" type="image/png" href="/assets/shuttlecock-favicon.png">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/referee-dashboard.css">
</head>
<body>

<div class="sidebar" id="sidebar">
    <div class="sidebar-header">
        <div class="logo">
            <i class="fas fa-shuttlecock shuttlecock"></i>
            <span>Referee Panel</span>
        </div>
    </div>
    
    <div class="sidebar-menu">
        <div class="menu-item active" data-section="assignedMatches">
            <i class="fas fa-calendar-check"></i>
            <span>Assigned Matches</span>
        </div>
        <div class="menu-item" data-section="completedMatches">
            <i class="fas fa-trophy"></i>
            <span>Completed Matches</span>
        </div>
    </div>
    
    <button class="logout-btn" id="logoutBtn">
        <i class="fas fa-sign-out-alt"></i>
        Logout
    </button>
</div>

<div class="main-content">
    <div class="header">
        <div class="menu-toggle" id="menuToggle">
            <i class="fas fa-bars"></i>
        </div>
        <div class="page-title">Referee</div>
        <div class="header-actions">
            <div class="user-menu">
                <div class="user-avatar">
                    <i class="fas fa-user"></i>
                </div>
                <span id="refereeName">Referee</span>
            </div>
        </div>
    </div>

    <div class="content">
        <!-- Assigned Matches Section -->
        <div class="section active" id="assignedMatchesSection">
            <div class="section-header">
                <div class="section-title">
                    <i class="fas fa-calendar-check"></i>
                    Assigned Matches
                </div>
                <div class="section-actions">
                    <div class="search-box">
                        <i class="fas fa-search search-icon"></i>
                        <input type="text" id="assignedMatchesSearch" placeholder="Search matches...">
                    </div>
                </div>
            </div>
            
            <div id="assignedMatchesContainer">
                <div class="match-cards" id="assignedMatchesGrid">
                    <!-- Match cards will be loaded dynamically -->
                </div>
                <div class="loading-state" id="assignedMatchesLoading">
                    <i class="fas fa-circle-notch fa-spin"></i>
                    <p>Loading assigned matches...</p>
                </div>
                <div class="no-matches-message" id="noAssignedMatches" style="display: none;">
                    <i class="fas fa-calendar-xmark"></i>
                    <h3>No Assigned Matches</h3>
                    <p>You currently don't have any assigned matches.</p>
                </div>
            </div>
        </div>

        <!-- Completed Matches Section -->
        <div class="section" id="completedMatchesSection" style="display: none;">
            <div class="section-header">
                <div class="section-title">
                    <i class="fas fa-trophy"></i>
                    Completed Matches
                </div>
                <div class="section-actions">
                    <div class="search-box">
                        <i class="fas fa-search search-icon"></i>
                        <input type="text" id="completedMatchesSearch" placeholder="Search completed matches...">
                    </div>
                </div>
            </div>
            
            <div id="completedMatchesContainer">
                <div class="match-cards" id="completedMatchesGrid">
                    <!-- Completed match cards will be loaded dynamically -->
                </div>
                <div class="loading-state" id="completedMatchesLoading">
                    <i class="fas fa-circle-notch fa-spin"></i>
                    <p>Loading completed matches...</p>
                </div>
                <div class="no-matches-message" id="noCompletedMatches" style="display: none;">
                    <i class="fas fa-calendar-check"></i>
                    <h3>No Completed Matches</h3>
                    <p>You haven't completed any matches yet.</p>
                </div>
            </div>
        </div>

        <!-- Match Set View Section -->
        <div class="section" id="matchSetSection" style="display: none;">
            <div class="section-header">
                <div class="section-title">
                    <i class="fas fa-table-tennis"></i>
                    <span id="matchSetTitle">Match Details</span>
                </div>
                <div class="section-actions">
                    <button class="btn btn-primary" id="backToMatches">
                        <i class="fas fa-arrow-left"></i> Back to Matches
                    </button>
                </div>
            </div>
            
            <div class="college-score">
                <div>
                    <div class="college-name" id="college1Name">College A</div>
                    <div class="college-score-value" id="college1Score">0</div>
                </div>
                <div class="vs">VS</div>
                <div>
                    <div class="college-name" id="college2Name">College B</div>
                    <div class="college-score-value" id="college2Score">0</div>
                </div>
            </div>
            
            <div class="submatches" id="subMatchesContainer">
                <!-- Submatch cards will be loaded dynamically -->
            </div>
        </div>
    </div>
</div>

<!-- Start Match Confirmation Modal -->
<div id="startMatchModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <h3>Start Match</h3>
            <span class="close" id="closeStartMatchModal">&times;</span>
        </div>
        <div class="modal-body">
            <p>Are you sure you want to start this match?</p>
            <p><strong id="matchTeams">College A vs College B</strong></p>
        </div>
        <div class="modal-footer">
            <button class="btn" id="cancelStartMatch">Cancel</button>
            <button class="btn btn-primary" id="confirmStartMatch">Start Match</button>
        </div>
    </div>
</div>

<!-- Start Submatch Modal -->
<div id="startSubmatchModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <h3>Start Submatch</h3>
            <span class="close" id="closeSubmatchModal">&times;</span>
        </div>
        <div class="modal-body">
            <p>Please enter the match details:</p>
            <div class="form-group">
                <label for="maxPoints">Max Points per Set:</label>
                <select id="maxPoints" class="form-control">
                    <option value="11">11 Points</option>
                    <option value="15">15 Points</option>
                    <option value="21" selected>21 Points</option>
                </select>
            </div>
            <div class="form-group">
                <label for="numberOfSets">Number of Sets:</label>
                <select id="numberOfSets" class="form-control">
                    <option value="1">Best of 1</option>
                    <option value="3" selected>Best of 3</option>
                    <option value="5">Best of 5</option>
                </select>
            </div>
            <div class="form-group">
                <label for="courtNumber">Court Number:</label>
                <select id="courtNumber" class="form-control">
                    <option value="1">Court 1</option>
                    <option value="2">Court 2</option>
                    <option value="3">Court 3</option>
                    <option value="4">Court 4</option>
                </select>
            </div>
            <div class="form-group">
                <label for="initialServer">Initial Server:</label>
                <select id="initialServer" class="form-control">
                    <option value="team1">College A</option>
                    <option value="team2">College B</option>
                </select>
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn" id="cancelSubmatch">Cancel</button>
            <button class="btn btn-primary" id="confirmSubmatch">Start</button>
        </div>
    </div>
</div>


<!-- Completed Submatch / Match Summary Modal -->
<div id="completedSubmatchModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <h3 id="completedModalTitle">Match Summary</h3>
            <span class="close" id="closeCompletedModal">&times;</span>
        </div>
        <div class="modal-body" id="completedModalBody">
            <!-- Summary content populated dynamically -->
            <div id="completedSummary"></div>
        </div>
    </div>
</div>

<!-- Automatic Match Winner Modal (No Cancel Button) -->
<div id="matchWinnerModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <h3 id="winnerModalTitle">Match Completed!</h3>
            <span class="close" id="closeWinnerModal">&times;</span>
        </div>
        <div class="modal-body" id="winnerModalBody">
            <div id="winnerSummary"></div>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-primary" id="finalEndMatchBtn">
                <i class="fas fa-flag-checkered"></i> End Match
            </button>
        </div>
    </div>
</div>

<script src="/js/referee-dashboard.js"></script>
</body>
</html>