<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Referee Dashboard - Shuttle Showdown</title>
    <link rel="icon" type="image/png" href="/assets/shuttlecock-favicon.png">
    <link rel="stylesheet" href="/css/referee-dashboard.css">
</head>
<body>
    <nav>
        <div class="left_nav">
            <img src="https://imgs.search.brave.com/5X28Tn65XcL0ddmlHA2cD4Hid5szvXvdXcpCcP0SiN0/rs:fit:860:0:0:0/g:ce/aHR0cHM6Ly91cGxv/YWQud2lraW1lZGlh/Lm9yZy93aWtpcGVk/aWEvY29tbW9ucy8w/LzAwL1BDQ09FLUxv/Z28tMjQucG5n" alt="PCCOE Logo">
            <h3>Referee Dashboard</h3>
        </div>

        <div class="right_nav">
            <span class="referee_name">Welcome, <span id="refereeName">Referee</span></span>
            <button id="logoutBtn">Logout</button>
        </div>
    </nav>

    <div class="main_content">
        <!-- Assigned Matches Section -->
        <section class="matches_section">
            <div class="section_header">
                <h2>Assigned Matches</h2>
                <div class="refresh_btn">
                    <button id="refreshMatches">🔄 Refresh</button>
                </div>
            </div>
            
            <div class="matches_container" id="assignedMatchesContainer">
                <!-- Assigned matches will be loaded here -->
            </div>
        </section>

        <!-- Completed Matches Section -->
        <section class="matches_section">
            <div class="section_header">
                <h2>Completed Matches</h2>
            </div>
            
            <div class="matches_container" id="completedMatchesContainer">
                <!-- Completed matches will be loaded here -->
            </div>
        </section>
    </div>

    <!-- Start Set Confirmation Modal -->
    <div id="startSetModal" class="modal">
        <div class="modal_overlay"></div>
        <div class="modal_content">
            <div class="modal_header">
                <h3>Start Match Set</h3>
                <button class="close_btn" id="closeStartSetModal">&times;</button>
            </div>
            
            <div class="modal_body">
                <div class="match_info">
                    <h4 id="matchTeams"></h4>
                    <p id="matchDetails"></p>
                </div>
                
                <form id="startSetForm">
                    <div class="form_group">
                        <label for="courtNumber">Court Number</label>
                        <select id="courtNumber" name="courtNumber" required>
                            <option value="">Select Court</option>
                            <option value="1">Court 1</option>
                            <option value="2">Court 2</option>
                            <option value="3">Court 3</option>
                            <option value="4">Court 4</option>
                        </select>
                    </div>
                    
                    <div class="form_group">
                        <label for="firstServeCollege">First Serve</label>
                        <select id="firstServeCollege" name="firstServeCollege" required>
                            <option value="">Select College</option>
                        </select>
                    </div>
                    
                    <div class="form_actions">
                        <button type="button" class="cancel_btn" id="cancelStartSet">Cancel</button>
                        <button type="submit" class="confirm_btn">Start Set</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Match Sets Modal -->
    <div id="matchSetsModal" class="modal">
        <div class="modal_overlay"></div>
        <div class="modal_content large">
            <div class="modal_header">
                <h3>Match Set - <span id="setMatchTeams"></span></h3>
                <button class="close_btn" id="closeMatchSetsModal">&times;</button>
            </div>
            
            <div class="modal_body">
                <!-- Set Score Display -->
                <div class="set_score_display">
                    <div class="college_score">
                        <h4 id="college1Name"></h4>
                        <span class="score" id="college1Score">0</span>
                    </div>
                    <div class="vs_separator">VS</div>
                    <div class="college_score">
                        <h4 id="college2Name"></h4>
                        <span class="score" id="college2Score">0</span>
                    </div>
                </div>

                <!-- Individual Matches -->
                <div class="individual_matches" id="individualMatches">
                    <!-- Individual match cards will be generated here -->
                </div>
            </div>
        </div>
    </div>

    <!-- Start Individual Match Modal -->
    <div id="startIndividualMatchModal" class="modal">
        <div class="modal_overlay"></div>
        <div class="modal_content">
            <div class="modal_header">
                <h3>Start Match</h3>
                <button class="close_btn" id="closeIndividualMatchModal">&times;</button>
            </div>
            
            <div class="modal_body">
                <div class="match_info">
                    <h4 id="individualMatchTitle"></h4>
                    <p id="individualMatchPlayers"></p>
                </div>
                
                <form id="startIndividualMatchForm">
                    <div class="form_row">
                        <div class="form_group">
                            <label for="maxPoints">Max Points</label>
                            <input type="number" id="maxPoints" name="maxPoints" value="21" min="1" max="30" required>
                        </div>
                        
                        <div class="form_group">
                            <label for="numberOfSets">Number of Sets</label>
                            <input type="number" id="numberOfSets" name="numberOfSets" value="3" min="1" max="5" required>
                        </div>
                    </div>
                    
                    <div class="form_row">
                        <div class="form_group">
                            <label for="matchCourtNumber">Court Number</label>
                            <select id="matchCourtNumber" name="matchCourtNumber" required>
                                <option value="">Select Court</option>
                                <option value="1">Court 1</option>
                                <option value="2">Court 2</option>
                                <option value="3">Court 3</option>
                                <option value="4">Court 4</option>
                            </select>
                        </div>
                        
                        <div class="form_group">
                            <label for="firstServePlayer">First Serve</label>
                            <select id="firstServePlayer" name="firstServePlayer" required>
                                <option value="">Select Player/Team</option>
                            </select>
                        </div>
                    </div>
                    
                    <div class="settings_note">
                        <p>💡 You can modify max points and number of sets using the settings button after starting the match.</p>
                    </div>
                    
                    <div class="form_actions">
                        <button type="button" class="cancel_btn" id="cancelIndividualMatch">Cancel</button>
                        <button type="submit" class="confirm_btn">Start Match</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Loading Spinner -->
    <div id="loadingSpinner" class="loading_spinner">
        <div class="spinner"></div>
        <p>Loading matches...</p>
    </div>

    <script src="/js/referee-dashboard.js"></script>
</body>
</html>