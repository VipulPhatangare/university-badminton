        // College Modal Functions
        let currentCollegeData = null;
        let currentPlayersView = 'boys';

        async function openCollegeDetailsModal(collegeId) {
            try {
                showAlert('Loading college details...', 'info');
                
                const response = await fetch(`/api/admin/colleges/${collegeId}`);
                const data = await response.json();
                
                if (data.success) {
                    currentCollegeData = data;
                    populateCollegeModal(data);
                    document.getElementById('collegeModal').style.display = 'flex';
                } else {
                    showAlert('Error loading college details: ' + data.message, 'error');
                }
            } catch (error) {
                console.error('Error opening college modal:', error);
                showAlert('Error loading college details', 'error');
            }
        }

        function populateCollegeModal(data) {
            const { college, players } = data;
            
            // Populate college information
            document.getElementById('modalTitle').textContent = `${college.collegeName} - College Information`;
            document.getElementById('modalCollegeName').textContent = college.collegeName || 'N/A';
            document.getElementById('modalCollegeEmail').textContent = college.email || 'N/A';
            document.getElementById('modalCollegeContact').textContent = college.phone || 'N/A';
            document.getElementById('modalCollegeAddress').textContent = college.address || 'N/A';
            
            // Update player counts
            const boysCount = players.boys ? players.boys.length : 0;
            const girlsCount = players.girls ? players.girls.length : 0;
            
            document.getElementById('boysCount').textContent = boysCount;
            document.getElementById('girlsCount').textContent = girlsCount;
            document.getElementById('boysPlayerCount').textContent = boysCount;
            document.getElementById('girlsPlayerCount').textContent = girlsCount;
            
            // Update progress bars
            const boysProgress = (boysCount / 7) * 100;
            const girlsProgress = (girlsCount / 5) * 100;
            
            document.getElementById('boysProgress').style.width = `${Math.min(boysProgress, 100)}%`;
            document.getElementById('girlsProgress').style.width = `${Math.min(girlsProgress, 100)}%`;
            
            // Update add button states
            document.getElementById('addBoysPlayerBtn').disabled = boysCount >= 7;
            document.getElementById('addGirlsPlayerBtn').disabled = girlsCount >= 5;
            
            if (boysCount >= 7) {
                document.getElementById('addBoysPlayerBtn').innerHTML = '<i class="fas fa-check"></i> Maximum Reached';
            }
            if (girlsCount >= 5) {
                document.getElementById('addGirlsPlayerBtn').innerHTML = '<i class="fas fa-check"></i> Maximum Reached';
            }
            
            // Load players for current view
            loadPlayersGrid();
        }

        function togglePlayersView(gender) {
            currentPlayersView = gender;
            
            // Update toggle buttons
            document.getElementById('boysPlayersToggle').classList.toggle('active', gender === 'boys');
            document.getElementById('girlsPlayersToggle').classList.toggle('active', gender === 'girls');
            
            // Show/hide sections
            document.getElementById('boysPlayersSection').style.display = gender === 'boys' ? 'block' : 'none';
            document.getElementById('girlsPlayersSection').style.display = gender === 'girls' ? 'block' : 'none';
            
            // Load players for the selected gender
