                            if (textContent.toLowerCase().indexOf(filter) > -1) {
                                found = true;
                                break;
                            }
                        }
                    }
                }

                if (found) {
                    row.style.display = '';
                    visibleCount++;
                } else {
                    row.style.display = 'none';
                }
            }

            // Update search input style based on filter activity
            if (filter !== '') {
                searchInput.style.borderColor = '#1565c0';
                searchInput.style.backgroundColor = '#e3f2fd';
            } else {
                searchInput.style.borderColor = '#e9ecef';
