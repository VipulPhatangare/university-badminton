                    });
                    playerCount += 4;
                }

                // Validate that we have some assignments
                if (subMatches.length === 0) {
                    showAlert('Please assign at least some players before saving', 'error');
                    return;
                }

                // Prepare assignment data
                const assignmentData = {
                    matchId: currentMatch._id,
                    gender: 'boys',
                    subMatches: subMatches
                };

                console.log('Saving match assignment:', assignmentData);

                // Send the complete assignment to the backend
                const response = await fetch('/api/admin/matches/assign', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(assignmentData)
                });
                
                const result = await response.json();
                
                if (result.success) {
                    // Show success message
                    showTimedAlert(`Match assignment saved successfully! ${playerCount} players assigned across ${subMatches.length} sub-matches.`, 'success', 3000);
                    
                    // Hide the setup form
                    const setupForm = document.getElementById('setupForm');
                    if (setupForm) {
                        setupForm.style.display = 'none';
