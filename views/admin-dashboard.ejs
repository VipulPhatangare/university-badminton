        function populateRefereeSelects() {
            const selects = document.querySelectorAll('.referee-select');
            
            selects.forEach(select => {
                const currentValue = select.value;
                select.innerHTML = '<option value="">Select Referee</option>';
                
                referees.forEach(referee => {
                    const option = document.createElement('option');
                    option.value = referee.refEmail;
                    option.textContent = `${referee.name} (${referee.refEmail})`;
                    select.appendChild(option);
                });
                
                select.value = currentValue;
            });

            // Add change listeners to prevent duplicate referee assignment
            selects.forEach(select => {
