                        round_1: colleges.filter(c => c.currentRoundBoys === 'round_1' && !c.isMatchAllocateBoys),
                        round_2: colleges.filter(c => c.currentRoundBoys === 'round_2' && !c.isMatchAllocateBoys),
                        quarter: colleges.filter(c => c.currentRoundBoys === 'quarter' && !c.isMatchAllocateBoys),
                        semi: colleges.filter(c => c.currentRoundBoys === 'semi' && !c.isMatchAllocateBoys),
                        final: colleges.filter(c => c.currentRoundBoys === 'final' && !c.isMatchAllocateBoys)
                    };

                    console.log('Round distribution:', {
                        round_1: rounds.round_1.length,
                        round_2: rounds.round_2.length,
                        quarter: rounds.quarter.length,
                        semi: rounds.semi.length,
                        final: rounds.final.length
                    });

                    // Update round info and populate dropdowns
                    updateRoundInfo('round1', rounds.round_1, 'Round 1');
                    updateRoundInfo('round2', rounds.round_2, 'Round 2');
                    updateRoundInfo('quarter', rounds.quarter, 'Quarter Finals');
                    updateRoundInfo('semi', rounds.semi, 'Semi Finals');
                    updateRoundInfo('final', rounds.final, 'Finals');

                    // Populate college dropdowns for each round
                    populateCollegeDropdowns('round1', rounds.round_1);
                    populateCollegeDropdowns('round2', rounds.round_2);
                    populateCollegeDropdowns('quarter', rounds.quarter);
                    populateCollegeDropdowns('semi', rounds.semi);
                    populateCollegeDropdowns('final', rounds.final);

                } else {
                    console.error('Failed to load colleges');
                }
            } catch (error) {
                console.error('Error loading colleges for schedule:', error);
            }
        }

        function updateRoundInfo(roundId, colleges, roundName) {
            const infoElement = document.getElementById(`${roundId}-info`);
            const collegesListElement = document.getElementById(`${roundId}-colleges`);
            
            if (infoElement) {
                infoElement.textContent = `${colleges.length} colleges available`;
            }

            if (collegesListElement) {
                collegesListElement.innerHTML = colleges.length > 0 ? 
                    colleges.map(college => `
                        <div class="college-item">
                            <span class="college-name">${college.collegeName}</span>
                            <span class="college-status available">Available</span>
                        </div>
                    `).join('') : 
                    '<div class="college-item"><span class="college-name">No colleges available for this round</span></div>';
            }
        }

        function populateCollegeDropdowns(roundId, colleges) {
            const college1Select = document.getElementById(`${roundId}-college1`);
            const college2Select = document.getElementById(`${roundId}-college2`);

            if (college1Select && college2Select) {
                // Clear existing options except default
                college1Select.innerHTML = '<option value="">Select College</option>';
                college2Select.innerHTML = '<option value="">Select College</option><option value="BYE">BYE</option>';

                // Add colleges to both dropdowns
                colleges.forEach(college => {
                    const option1 = document.createElement('option');
                    option1.value = college.email;
                    option1.textContent = college.collegeName;
                    option1.setAttribute('data-name', college.collegeName);
                    college1Select.appendChild(option1);

                    const option2 = document.createElement('option');
                    option2.value = college.email;
                    option2.textContent = college.collegeName;
                    option2.setAttribute('data-name', college.collegeName);
                    college2Select.appendChild(option2);
                });
            }
        }

        async function createMatch(round, gender) {
            // Convert round format for HTML IDs (round_1 -> round1, etc.)
            let roundId = round.replace('_', '');
            
            // Handle special cases for quarter, semi, final (no numbers)
            if (round === 'quarter' || round === 'semi' || round === 'final') {
                roundId = round;
            }
            
            console.log('Looking for elements with roundId:', roundId);
            console.log('Expected IDs:', `${roundId}-college1`, `${roundId}-college2`, `${roundId}-date`, `${roundId}-time`);
            
            const college1Select = document.getElementById(`${roundId}-college1`);
            const college2Select = document.getElementById(`${roundId}-college2`);
            const dateSelect = document.getElementById(`${roundId}-date`);
            const timeSelect = document.getElementById(`${roundId}-time`);

            // Debug: Check if elements exist
            console.log('Elements found:', {
                college1Select: college1Select,
                college2Select: college2Select,
                dateSelect: dateSelect,
                timeSelect: timeSelect
            });

            // Validate inputs
            if (!college1Select || !college2Select || !dateSelect || !timeSelect) {
                showAlert('Missing form elements. Please refresh the page.', 'error');
                return;
            }

            if (!college1Select.value || !college2Select.value || !dateSelect.value || !timeSelect.value) {
                showAlert('Please fill in all fields', 'error');
                return;
            }

            if (college1Select.value === college2Select.value && college2Select.value !== 'BYE') {
                showAlert('Cannot select the same college for both teams', 'error');
                return;
            }

            const matchData = {
                round: round.replace(/\d+/, '').replace('-', '_'), // Convert round1 to round_1
                gender: gender,
                college1Email: college1Select.value,
                college1Name: college1Select.options[college1Select.selectedIndex].getAttribute('data-name') || college1Select.options[college1Select.selectedIndex].text,
                college2Email: college2Select.value,
                college2Name: college2Select.value === 'BYE' ? 'BYE' : 
                              (college2Select.options[college2Select.selectedIndex].getAttribute('data-name') || college2Select.options[college2Select.selectedIndex].text),
                date: dateSelect.value,
                time: timeSelect.value,
                court: `Court ${Math.floor(Math.random() * 4) + 1}`, // Random court assignment
                matchStatus: 'upcoming'
            };

            try {
                const response = await fetch('/api/admin/schedule/create-match', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(matchData)
                });

                const result = await response.json();
                
                if (result.success) {
                    showAlert('Match created successfully!', 'success');
                    
                    // Add match to the UI
                    addMatchToSchedule(round, matchData);
                    
                    // Clear form
                    college1Select.value = '';
                    college2Select.value = '';
                    
                    // Reload colleges to update availability
                    loadCollegesForSchedule();
                } else {
                    showAlert(`Error creating match: ${result.message}`, 'error');
                }
            } catch (error) {
                console.error('Error creating match:', error);
                showAlert('Error creating match. Please try again.', 'error');
            }
        }

        function addMatchToSchedule(roundId, matchData) {
            const matchesContainer = document.getElementById(`${roundId}-matches`);
            if (matchesContainer) {
                const matchCard = document.createElement('div');
                matchCard.className = 'match-card';
                matchCard.innerHTML = `
                    <div class="match-info">
                        <div class="match-teams">${matchData.college1Name} vs ${matchData.college2Name}</div>
                        <div class="match-details">
                            <span><i class="fas fa-calendar"></i> ${new Date(matchData.date).toLocaleDateString()}</span>
                            <span><i class="fas fa-clock"></i> ${matchData.time}</span>
                            <span><i class="fas fa-map-marker-alt"></i> ${matchData.court}</span>
                        </div>
                    </div>
                `;
                matchesContainer.appendChild(matchCard);
            }
        }

        // Search Filter Functions
        
        // Filter Colleges
        function filterColleges() {
            const searchInput = document.getElementById('collegesSearchInput');
            const filter = searchInput.value.toLowerCase();
            const table = document.getElementById('colleges-table');
            const rows = table.getElementsByTagName('tr');
            let visibleCount = 0;

            for (let i = 0; i < rows.length; i++) {
                const row = rows[i];
                const cells = row.getElementsByTagName('td');
                let found = false;

                // If no filter, show all
                if (filter === '') {
                    found = true;
                } else {
                    for (let j = 0; j < cells.length - 1; j++) { // Exclude last column (Actions)
                        if (cells[j]) {
                            const textContent = cells[j].textContent || cells[j].innerText;
                            if (textContent.toLowerCase().indexOf(filter) > -1) {
                                found = true;
                                break;
                            }
                        }
                    }
                }

                if (found) {
                    row.style.display = '';
                    visibleCount++;
                } else {
                    row.style.display = 'none';
                }
            }

            // Update search input style based on filter activity
            if (filter !== '') {
                searchInput.style.borderColor = '#1565c0';
                searchInput.style.backgroundColor = '#e3f2fd';
            } else {
                searchInput.style.borderColor = '#e9ecef';
                searchInput.style.backgroundColor = '#ffffff';
            }
        }

