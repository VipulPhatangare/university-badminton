                    select.appendChild(option);
                });
                
                select.value = currentValue;
            });

            // Add change listeners to prevent duplicate referee assignment
            selects.forEach(select => {
                select.addEventListener('change', updateAssignedRefereesList);
            });
        }

        function updateAssignedRefereesList() {
            const container = document.getElementById('assignedRefereesList');
            
            // Check if the container exists, if not, just return to avoid errors
            if (!container) {
                console.warn('assignedRefereesList element not found');
                return;
            }
            
            const assignedEmails = [];
            
            for (let i = 1; i <= 5; i++) {
                const refSelect = document.getElementById(`match${i}_referee`);
                if (refSelect && refSelect.value && !assignedEmails.includes(refSelect.value)) {
                    assignedEmails.push(refSelect.value);
                }
            }
            
            if (assignedEmails.length === 0) {
                container.innerHTML = '<p class="text-muted">No referees assigned yet</p>';
                return;
            }
            
            container.innerHTML = assignedEmails.map(email => {
                const referee = referees.find(r => r.refEmail === email);
                return `<div class="referee-badge">${referee ? referee.name : email}</div>`;
            }).join('');
        }

