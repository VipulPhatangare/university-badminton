            }

            // Show confirmation dialog
            const confirmation = confirm(`Are you sure you want to assign the selected referee and players to this match?\n\nThis will update the match with player assignments and cannot be easily undone.`);
            if (!confirmation) {
                return;
            }

            try {
                const assignmentData = {
                    refereeId: refereeId,
                    ...playerAssignments
                };

                const response = await fetch(`/api/admin/assign-match/${currentMatch._id}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(assignmentData)
                });

                const result = await response.json();
                if (result.success) {
                    showAlert('Players and referee assigned successfully!', 'success');
                    await loadMatches();
                    
                    // Hide the setup form and refresh match cards
                    document.getElementById('setupForm').style.display = 'none';
                    displaySetupMatchCards();
                } else {
                    showAlert('Error assigning players: ' + result.message, 'error');
                }
            } catch (error) {
                console.error('Error assigning players:', error);
                showAlert('Error assigning players', 'error');
            }
        }

        function collectPlayerAssignments() {
            const assignments = {};
            
            try {
                // Match 1 - Singles
                const match1Player1 = document.getElementById('match1_player1').value;
                const match1Player2 = document.getElementById('match1_player2').value;
                
                if (match1Player1 && match1Player2) {
                    const player1Data = JSON.parse(match1Player1);
                    const player2Data = JSON.parse(match1Player2);
                    
                    assignments.match1Singles = {
                        player1Name: player1Data.name,
                        player1Email: player1Data.email,
                        player2Name: player2Data.name,
                        player2Email: player2Data.email
                    };
                }
                
                // Match 2 - Singles
                const match2Player1 = document.getElementById('match2_player1').value;
                const match2Player2 = document.getElementById('match2_player2').value;
                
                if (match2Player1 && match2Player2) {
                    const player1Data = JSON.parse(match2Player1);
                    const player2Data = JSON.parse(match2Player2);
                    
                    assignments.match2Singles = {
                        player1Name: player1Data.name,
                        player1Email: player1Data.email,
                        player2Name: player2Data.name,
                        player2Email: player2Data.email
                    };
                }
                
                // Match 3 - Doubles
                const match3Team1Player1 = document.getElementById('match3_team1_player1').value;
                const match3Team1Player2 = document.getElementById('match3_team1_player2').value;
                const match3Team2Player1 = document.getElementById('match3_team2_player1').value;
                const match3Team2Player2 = document.getElementById('match3_team2_player2').value;
                
                if (match3Team1Player1 && match3Team1Player2 && match3Team2Player1 && match3Team2Player2) {
                    const team1Player1Data = JSON.parse(match3Team1Player1);
                    const team1Player2Data = JSON.parse(match3Team1Player2);
                    const team2Player1Data = JSON.parse(match3Team2Player1);
                    const team2Player2Data = JSON.parse(match3Team2Player2);
                    
                    assignments.match3Doubles = {
                        team1Player1Name: team1Player1Data.name,
                        team1Player1Email: team1Player1Data.email,
                        team1Player2Name: team1Player2Data.name,
                        team1Player2Email: team1Player2Data.email,
                        team2Player1Name: team2Player1Data.name,
                        team2Player1Email: team2Player1Data.email,
                        team2Player2Name: team2Player2Data.name,
                        team2Player2Email: team2Player2Data.email
                    };
                }
                
                // Match 4 - Singles
                const match4Player1 = document.getElementById('match4_player1').value;
                const match4Player2 = document.getElementById('match4_player2').value;
                
                if (match4Player1 && match4Player2) {
                    const player1Data = JSON.parse(match4Player1);
                    const player2Data = JSON.parse(match4Player2);
                    
                    assignments.match4Singles = {
                        player1Name: player1Data.name,
                        player1Email: player1Data.email,
                        player2Name: player2Data.name,
                        player2Email: player2Data.email
                    };
                }
                
                // Match 5 - Doubles
                const match5Team1Player1 = document.getElementById('match5_team1_player1').value;
                const match5Team1Player2 = document.getElementById('match5_team1_player2').value;
                const match5Team2Player1 = document.getElementById('match5_team2_player1').value;
                const match5Team2Player2 = document.getElementById('match5_team2_player2').value;
                
                if (match5Team1Player1 && match5Team1Player2 && match5Team2Player1 && match5Team2Player2) {
                    const team1Player1Data = JSON.parse(match5Team1Player1);
                    const team1Player2Data = JSON.parse(match5Team1Player2);
                    const team2Player1Data = JSON.parse(match5Team2Player1);
                    const team2Player2Data = JSON.parse(match5Team2Player2);
                    
                    assignments.match5Doubles = {
                        team1Player1Name: team1Player1Data.name,
                        team1Player1Email: team1Player1Data.email,
                        team1Player2Name: team1Player2Data.name,
                        team1Player2Email: team1Player2Data.email,
                        team2Player1Name: team2Player1Data.name,
                        team2Player1Email: team2Player1Data.email,
                        team2Player2Name: team2Player2Data.name,
                        team2Player2Email: team2Player2Data.email
                    };
                }
                
                console.log('Collected assignments:', assignments);
                
                // Validate that at least one match is assigned
                if (Object.keys(assignments).length === 0) {
                    showAlert('Please assign players and referees to at least one match', 'error');
                    return null;
                }
                
                return assignments;
                
            } catch (error) {
                console.error('Error collecting player assignments:', error);
                showAlert('Error collecting player assignments', 'error');
                return null;
            }
        }

        function resetAssignment() {
            if (confirm('Are you sure you want to reset all assignments? This will clear all selected players and referee.')) {
                document.getElementById('main_referee').value = '';
                // Reset all player dropdowns in the dynamic content
                const playerSelects = document.querySelectorAll('#player-assignment-container select');
                playerSelects.forEach(select => select.value = '');
            }
        }
    </script>
</body>
</html>