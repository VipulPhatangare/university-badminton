        // Player Management Functions
        function addPlayer(gender) {
            if (!currentCollegeData) return;
            
            const maxPlayers = gender === 'boys' ? 7 : 5;
            const currentPlayers = currentCollegeData.players[gender] || [];
            
            if (currentPlayers.length >= maxPlayers) {
                showAlert(`Maximum ${maxPlayers} ${gender} players allowed`, 'error');
                return;
            }
            
            // Open player modal for adding
            openPlayerModal('add', gender);
        }

        function editPlayer(playerId) {
            if (!currentCollegeData) return;
            
            // Find the player in current data
            const allPlayers = [...(currentCollegeData.players.boys || []), ...(currentCollegeData.players.girls || [])];
            const player = allPlayers.find(p => p._id === playerId);
            
            if (player) {
                openPlayerModal('edit', player.gender, player);
            }
        }

        async function deletePlayer(playerId, playerName) {
            if (!confirm(`Are you sure you want to delete player "${playerName}"?\n\nThis action cannot be undone.`)) {
                return;
            }
            
            try {
                const response = await fetch(`/api/admin/players/${playerId}`, {
                    method: 'DELETE'
