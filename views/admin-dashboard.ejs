                if (setup[matchKey]) {
                    document.getElementById(`match${i}_referee`).value = setup[matchKey].refereeEmail || '';
                    document.getElementById(`match${i}_maxPoints`).value = setup[matchKey].maxPoints || 21;
                    document.getElementById(`match${i}_sets`).value = setup[matchKey].numberOfSets || 3;
