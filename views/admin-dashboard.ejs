        async function loadAllMatches() {
            try {
                // Load both boys and girls matches
                const [boysResponse, girlsResponse] = await Promise.all([
                    fetch('/api/admin/matches/boys'),
                    fetch('/api/admin/matches/girls')
                ]);
                
                const boysResult = await boysResponse.json();
                const girlsResult = await girlsResponse.json();
                
                let allMatches = [];
                
                if (boysResult.success) {
                    allMatches = [...allMatches, ...boysResult.matches.map(match => ({...match, gender: 'boys'}))];
                }
                
                if (girlsResult.success) {
                    allMatches = [...allMatches, ...girlsResult.matches.map(match => ({...match, gender: 'girls'}))];
                }
                
                allMatchesData = allMatches;
                displayMatches(allMatches);
                updateMatchCounts(allMatches);
                
            } catch (error) {
                console.error('Error loading matches:', error);
                showAlert('Error loading matches', 'error');
            }
        }
        
