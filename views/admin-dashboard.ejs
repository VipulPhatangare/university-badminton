        function populatePlayerDropdownWithExclusions(selectId, players, excludedPlayerEmails) {
            const select = document.getElementById(selectId);
            if (!select) return;
            
            // Get current selection to preserve it
            const currentValue = select.value;
            let currentPlayerEmail = null;
            
            if (currentValue) {
                try {
                    const currentPlayerData = JSON.parse(currentValue);
                    currentPlayerEmail = currentPlayerData.email;
                } catch (e) {
                    // Handle parsing error
                }
            }
            
            select.innerHTML = '<option value="">Select Player</option>';
            
            console.log(`Populating ${selectId} with ${players.length} players, excluding ${excludedPlayerEmails.size} selected players`);
            
            players.forEach(player => {
                const playerEmail = player.email;
                const playerName = player.playerName || player.name;
                
                // Show player if:
                // 1. Not already selected in another dropdown OR
                // 2. It's the currently selected player in this dropdown
                if (!excludedPlayerEmails.has(playerEmail) || playerEmail === currentPlayerEmail) {
                    const option = document.createElement('option');
                    option.value = JSON.stringify({name: playerName, email: playerEmail});
                    option.textContent = playerName;
                    
                    // Restore selection if it was the current player
                    if (playerEmail === currentPlayerEmail) {
                        option.selected = true;
                    }
                    
                    select.appendChild(option);
                }
            });
        }

        function getSelectedPlayerEmails() {
            const selectedPlayers = new Set();
            
            const allPlayerSelects = [
                'match1_player1', 'match1_player2',
                'match2_player1', 'match2_player2',
                'match3_team1_player1', 'match3_team1_player2', 
                'match3_team2_player1', 'match3_team2_player2',
                'match4_player1', 'match4_player2',
                'match5_team1_player1', 'match5_team1_player2', 
                'match5_team2_player1', 'match5_team2_player2'
            ];
            
            allPlayerSelects.forEach(selectId => {
                const select = document.getElementById(selectId);
                if (select && select.value) {
                    try {
                        const playerData = JSON.parse(select.value);
                        selectedPlayers.add(playerData.email);
                    } catch (e) {
                        // Handle parsing error
                    }
                }
            });
            
            return selectedPlayers;
        }

