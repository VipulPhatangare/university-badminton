        // Filter Setup Matches
        function filterSetupMatches() {
            const searchInput = document.getElementById('setupMatchesSearchInput');
            const filter = searchInput.value.toLowerCase();
            const matchCards = document.querySelectorAll('#setup-matches-container .setup-match-card');
            let visibleCount = 0;

            matchCards.forEach(card => {
                const college1 = card.querySelector('.setup-match-header h3')?.textContent || '';
                const round = card.querySelector('.setup-match-info')?.textContent || '';
                const status = card.querySelector('.setup-match-status')?.textContent || '';
                
                const searchText = (college1 + ' ' + round + ' ' + status).toLowerCase();
                
                if (filter === '' || searchText.includes(filter)) {
                    card.style.display = '';
                    visibleCount++;
                } else {
                    card.style.display = 'none';
                }
            });

            // Also filter the loading and no-matches cards if they exist
            const specialCards = document.querySelectorAll('#setup-matches-container .loading-card, #setup-matches-container .no-matches-card');
            specialCards.forEach(card => {
                if (filter === '') {
                    card.style.display = '';
                } else {
                    card.style.display = 'none';
                }
            });

            // Update search input style based on filter activity
            if (filter !== '') {
                searchInput.style.borderColor = '#28a745';
                searchInput.style.backgroundColor = '#f8fff9';
            } else {
                searchInput.style.borderColor = '#e9ecef';
                searchInput.style.backgroundColor = '#ffffff';
            }
        }

        // Clear Search Functions
        function clearCollegeSearch() {
            const searchInput = document.getElementById('collegesSearchInput');
            searchInput.value = '';
            filterColleges();
        }

        function clearRefereeSearch() {
            const searchInput = document.getElementById('refereesSearchInput');
            searchInput.value = '';
            filterReferees();
        }

        function clearSetupMatchSearch() {
            const searchInput = document.getElementById('setupMatchesSearchInput');
            searchInput.value = '';
            filterSetupMatches();
        }


    </script>
