                                <input type="text" id="refereeName" name="name" class="form-control" required>
                            </div>
                            
                            <div class="form-group">
                                <label for="refereeEmail">Email *</label>
                                <input type="email" id="refereeEmail" name="refEmail" class="form-control" required>
                            </div>
                            
                            <div class="form-group">
                                <label for="refereePhone">Phone Number</label>
                                <input type="tel" id="refereePhone" name="phone" class="form-control">
                            </div>
                            
                            <div class="form-group">
                                <label for="refereePassword">Password *</label>
                                <input type="password" id="refereePassword" name="password" class="form-control" required>
                                <small class="form-text text-muted">Password for referee dashboard login</small>
                            </div>
                        </form>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" onclick="closeRefereeModal()">Cancel</button>
                        <button type="button" class="btn btn-primary" onclick="saveReferee()">
                            <span id="saveRefereeBtnText">Add Referee</span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Referees Page -->
            <div id="referees-page" style="display: none;">
                <div class="section">
                    <div class="section-header">
                        <div class="section-title">Referees Management</div>
                        <div class="section-actions">
                            <div class="search-box">
                                <i class="fas fa-search search-icon"></i>
                                <input type="text" id="refereesSearchInput" placeholder="Search referees by name, email, or contact..." onkeyup="filterReferees()" onchange="filterReferees()">
                            </div>
                            <button onclick="clearRefereeSearch()" class="btn btn-secondary">
                                <i class="fas fa-times"></i> Clear
                            </button>
                            <button onclick="openRefereeModal()" class="btn btn-primary">
                                <i class="fas fa-plus"></i> Add Referee
                            </button>
                            <button onclick="refreshReferees()" class="btn btn-secondary">
                                <i class="fas fa-sync-alt"></i> Refresh
                            </button>
                        </div>
                    </div>
                    
                    <div class="table-container">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th><i class="fas fa-user"></i> Name</th>
                                    <th><i class="fas fa-envelope"></i> Email</th>
                                    <th><i class="fas fa-phone"></i> Contact</th>
                                    <th><i class="fas fa-certificate"></i> Experience</th>
                                    <th><i class="fas fa-tasks"></i> Assigned Matches</th>
                                    <th><i class="fas fa-chart-bar"></i> Status</th>
                                    <th><i class="fas fa-cogs"></i> Actions</th>
                                </tr>
                            </thead>
                            <tbody id="referees-table">
                                <!-- Referees data will be loaded here -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Matches Page -->
            <div id="matches-page" style="display: none;">
                <div class="section">
                    <div class="section-header">
                        <div class="section-title">Matches Management</div>
                        <div class="section-actions">
                            <button onclick="refreshMatches()" class="btn btn-secondary">
                                <i class="fas fa-sync-alt"></i> Refresh
                            </button>
                        </div>
                    </div>

                    <!-- Filters and Search Bar -->
                    <div class="matches-filters">
                        <div class="filter-row">
                            <div class="search-container">
                                <div class="search-box">
                                    <i class="fas fa-search"></i>
                                    <input type="text" id="matchesSearchInput" placeholder="Search by college names, status, or date..." onkeyup="filterMatches()">
                                </div>
                            </div>
                            
                            <div class="filter-buttons">
                                <button class="filter-btn active" data-status="all" onclick="setMatchFilter('all')">
                                    <i class="fas fa-list"></i> All Matches
                                    <span class="badge" id="allMatchesCount">0</span>
                                </button>
                                <button class="filter-btn" data-status="upcoming" onclick="setMatchFilter('upcoming')">
                                    <i class="fas fa-clock"></i> Upcoming
                                    <span class="badge" id="upcomingCount">0</span>
                                </button>
                                <button class="filter-btn" data-status="live" onclick="setMatchFilter('live')">
                                    <i class="fas fa-play-circle"></i> Live
                                    <span class="badge" id="liveCount">0</span>
                                </button>
                                <button class="filter-btn" data-status="complete" onclick="setMatchFilter('complete')">
                                    <i class="fas fa-check-circle"></i> Completed
                                    <span class="badge" id="completedCount">0</span>
                                </button>
                            </div>

                            <div class="gender-filter">
                                <select id="genderFilter" onchange="filterMatches()">
                                    <option value="all">All Categories</option>
                                    <option value="boys">Boys Matches</option>
                                    <option value="girls">Girls Matches</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- Matches Table -->
                    <div class="table-container">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th><i class="fas fa-trophy"></i> Match</th>
                                    <th><i class="fas fa-venus-mars"></i> Category</th>
                                    <th><i class="fas fa-calendar"></i> Date & Time</th>
                                    <th><i class="fas fa-map-marker-alt"></i> Court</th>
                                    <th><i class="fas fa-layer-group"></i> Round</th>
                                    <th><i class="fas fa-user-tie"></i> Referee</th>
                                    <th><i class="fas fa-flag"></i> Status</th>
                                    <th><i class="fas fa-cogs"></i> Actions</th>
                                </tr>
                            </thead>
                            <tbody id="matches-table">
                                <!-- Matches data will be loaded here -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Admin Dashboard JavaScript
        let matches = [];
        let colleges = [];
        let referees = [];
        let allPlayers = [];
        let allReferees = [];
        let currentMatch = null;

        // Initialize dashboard
        document.addEventListener('DOMContentLoaded', function() {
            setupNavigation();
            loadDashboardData();
            setupModalEventListeners();
        });

        // Setup modal event listeners
        function setupModalEventListeners() {
            // Close modals when clicking outside
            document.getElementById('collegeModal').addEventListener('click', function(e) {
                if (e.target === this) {
                    closeCollegeModal();
                }
            });

            document.getElementById('playerModal').addEventListener('click', function(e) {
                if (e.target === this) {
                    closePlayerModal();
                }
            });

            // Close modals with Escape key
            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape') {
                    if (document.getElementById('playerModal').style.display === 'flex') {
                        closePlayerModal();
                    } else if (document.getElementById('collegeModal').style.display === 'flex') {
                        closeCollegeModal();
                    }
                }
            });
        }

        // Navigation setup
        function setupNavigation() {
            const menuItems = document.querySelectorAll('.menu-item');
            const pages = document.querySelectorAll('[id$="-page"]');

            menuItems.forEach(item => {
                item.addEventListener('click', function() {
                    const targetPage = this.dataset.page + '-page';
                    
                    // Update active menu item
                    menuItems.forEach(mi => mi.classList.remove('active'));
                    this.classList.add('active');
                    
                    // Show target page
                    pages.forEach(page => page.style.display = 'none');
                    const target = document.getElementById(targetPage);
                    if (target) {
                        target.style.display = 'block';
                        
                        // Load data for specific pages
                        if (targetPage === 'colleges-page') {
                            loadColleges();
                        } else if (targetPage === 'referees-page') {
                            loadReferees();
                        } else if (targetPage === 'matches-page') {
                            loadAllMatches();
                        } else if (targetPage === 'match-setup-page') {
                            loadMatchesForSetup();
                        } else if (targetPage === 'schedule-generator-page') {
                            // Initialize schedule generator when page loads
                            setTimeout(() => {
                                initScheduleGenerator();
                            }, 100);
                        }
                    }
                });
            });

            // Mobile menu toggle
            const menuToggle = document.getElementById('menu-toggle');
            const sidebar = document.getElementById('sidebar');
            const overlay = document.getElementById('overlay');

            if (menuToggle) {
                menuToggle.addEventListener('click', function() {
                    sidebar.classList.toggle('active');
                    overlay.classList.toggle('active');
                });
            }

            if (overlay) {
                overlay.addEventListener('click', function() {
                    sidebar.classList.remove('active');
                    overlay.classList.remove('active');
                });
            }
        }

        // Load dashboard data
        async function loadDashboardData() {
            try {
                await Promise.all([
                    loadMatches(),
                    loadReferees(),
                    loadColleges(),
                    loadAllPlayers(),
                    loadAllReferees()
                ]);
                updateStatistics();
                loadRecentActivity();
            } catch (error) {
                console.error('Error loading dashboard data:', error);
                showAlert('Error loading dashboard data', 'error');
            }
        }

        // Load matches
        async function loadMatches() {
            try {
                const response = await fetch('/api/admin/get-all-matches');
                const data = await response.json();
                
                if (data.success) {
                    matches = data.matches;
                    return matches;
                } else {
                    throw new Error(data.message);
                }
            } catch (error) {
                console.error('Error loading matches:', error);
                matches = [];
                return [];
            }
        }

        // Load colleges
        async function loadColleges() {
            try {
                const response = await fetch('/api/admin/get-colleges');
                const data = await response.json();
                
                if (data.success) {
                    colleges = data.colleges;
                    renderCollegesTable();
                    return colleges;
                } else {
                    throw new Error(data.message);
                }
            } catch (error) {
                console.error('Error loading colleges:', error);
                colleges = [];
                return [];
            }
        }

        // Load referees
        async function loadReferees() {
            try {
                const response = await fetch('/api/admin/get-referees');
                const data = await response.json();
                if (data.success) {
                    referees = data.referees;
                    renderRefereesTable();
                    populateRefereeSelects();
                    return referees;
                }
            } catch (error) {
                console.error('Error loading referees:', error);
                referees = [];
                return [];
            }
        }

        // Load all players for match assignment
        async function loadAllPlayers() {
            try {
                const response = await fetch('/api/admin/get-players');
                const data = await response.json();
                if (data.success) {
                    allPlayers = data.players;
                    return allPlayers;
                }
            } catch (error) {
                console.error('Error loading all players:', error);
                allPlayers = [];
                return [];
            }
        }

        // Load all referees for match assignment
        async function loadAllReferees() {
            try {
                const response = await fetch('/api/admin/get-referees');
                const data = await response.json();
                if (data.success) {
                    allReferees = data.referees;
                    return allReferees;
                }
            } catch (error) {
                console.error('Error loading all referees:', error);
                allReferees = [];
                return [];
            }
        }

        // Update statistics
        function updateStatistics() {
            const total = matches.length;
            const upcoming = matches.filter(m => ['upcoming', 'setup_completed', 'players_allocated'].includes(m.matchStatus)).length;
            const live = matches.filter(m => m.matchStatus === 'live').length;
            const completed = matches.filter(m => m.matchStatus === 'complete').length;

            document.getElementById('totalMatches').textContent = total;
            document.getElementById('upcomingMatches').textContent = upcoming;
            document.getElementById('liveMatches').textContent = live;
            document.getElementById('completedMatches').textContent = completed;
        }

        // Load recent activity
        function loadRecentActivity() {
            const activityContainer = document.getElementById('recent-activity');
            const recentMatches = matches
                .filter(m => m.matchStatus !== 'upcoming')
                .sort((a, b) => new Date(b.date) - new Date(a.date))
                .slice(0, 5);

            if (recentMatches.length === 0) {
                activityContainer.innerHTML = '<p class="text-center text-muted">No recent activity</p>';
                return;
            }

            activityContainer.innerHTML = recentMatches.map(match => `
                <div class="activity-item">
                    <div class="activity-icon">
                        <i class="fas fa-${getActivityIcon(match.matchStatus)}"></i>
                    </div>
                    <div class="activity-content">
                        <strong>${match.college1Name} vs ${match.college2Name}</strong>
                        <div class="activity-time">${getActivityText(match)}</div>
                    </div>
                </div>
            `).join('');
        }

        function getActivityIcon(status) {
            const icons = {
                'live': 'play-circle',
                'complete': 'check-circle',
                'setup_completed': 'cogs',
                'players_allocated': 'users'
            };
            return icons[status] || 'clock';
        }

        function getActivityText(match) {
            const statusTexts = {
                'live': 'Match is currently live',
                'complete': 'Match completed',
                'setup_completed': 'Setup completed, awaiting player allocation',
                'players_allocated': 'Players allocated, ready to start'
            };
            return statusTexts[match.matchStatus] || 'Status updated';
        }

        // Match Setup Functions
        let college1Players = [];
        let college2Players = [];

        async function loadMatchesForSetup() {
            await loadReferees(); // Make sure referees are loaded
            displaySetupMatchCards();
        }

        function displaySetupMatchCards() {
            const container = document.getElementById('setup-matches-container');
            
            // Filter for upcoming matches only that don't have complete setup
            const upcomingMatches = matches.filter(match => {
                const isUpcoming = match.matchStatus === 'upcoming' || 
                                 match.matchStatus === 'setup_required' ||
                                 !match.matchStatus;
                
                // Check if match setup is complete (has players allocated)
                const hasPlayersAllocated = match.match1Singles && 
                                          match.match1Singles.player1Name &&
                                          match.match2Singles && 
                                          match.match2Singles.player1Name &&
                                          match.match3Doubles &&
                                          match.match3Doubles.team1Player1Name &&
                                          match.match4Singles &&
                                          match.match4Singles.player1Name &&
                                          match.match5Doubles &&
                                          match.match5Doubles.team1Player1Name;
                
                return isUpcoming && !hasPlayersAllocated;
            });

            if (upcomingMatches.length === 0) {
                container.innerHTML = `
                    <div class="no-matches-card">
                        <i class="fas fa-check-circle"></i>
                        <h3>No Upcoming Matches Need Setup</h3>
                        <p>All upcoming matches have been configured or no upcoming matches found.</p>
                        <button onclick="refreshMatchCards()" class="btn btn-primary">
                            <i class="fas fa-sync-alt"></i> Refresh
                        </button>
                    </div>
                `;
                return;
            }

            container.innerHTML = upcomingMatches.map(match => createSetupMatchCard(match)).join('');
        }

        function createSetupMatchCard(match) {
            const hasPlayersAllocated = match.match1Singles && match.match1Singles.player1Name;
            const statusText = hasPlayersAllocated ? 'Setup Complete' : 'Setup Required';
            const statusClass = hasPlayersAllocated ? 'configured' : 'needs-setup';
            const statusBadgeClass = hasPlayersAllocated ? 'status-configured' : 'status-needs-setup';

            return `
                <div class="setup-match-card ${statusClass}" onclick="openMatchSetupModal('${match._id}')">
                    <div class="setup-match-header">
                        <h3>
                            <i class="fas fa-shuttle-van"></i>
                            ${match.college1Name} vs ${match.college2Name}
                        </h3>
                        <span class="setup-match-status ${statusBadgeClass}">${statusText}</span>
                    </div>
                    <div class="setup-match-info">
                        <p><strong>Match ID:</strong> ${match._id}</p>
                        <p><strong>Date:</strong> ${new Date(match.date).toLocaleDateString()}</p>
                        <p><strong>Time:</strong> ${match.time}</p>
                        <p><strong>Status:</strong> ${getMatchStatusText(match.matchStatus)}</p>
                        ${hasPlayersAllocated ? `
                            <p><strong>Progress:</strong> <span style="color: green;">✓ Players assigned</span></p>
                        ` : `
                            <p><strong>Progress:</strong> <span style="color: orange;">⚠ Needs configuration</span></p>
                        `}
                    </div>
                    <div class="setup-match-actions">
                        ${hasPlayersAllocated ? `
                            <button class="btn btn-success" disabled>
                                <i class="fas fa-check"></i> Setup Complete
                            </button>
                        ` : `
                            <button class="btn btn-primary">
                                <i class="fas fa-cog"></i> Configure Match & Players
                            </button>
                        `}
                    </div>
                </div>
            `;
        }

        function isMatchFullyConfigured(matchSetup) {
            if (!matchSetup) return false;
            
            // Check if all 5 matches have required configuration
            for (let i = 1; i <= 5; i++) {
                const matchKey = `match${i}`;
                if (!matchSetup[matchKey] || 
                    !matchSetup[matchKey].refereeEmail || 
                    !matchSetup[matchKey].maxPoints || 
                    !matchSetup[matchKey].numberOfSets || 
                    !matchSetup[matchKey].courtNumber) {
                    return false;
                }
            }
            return true;
        }

        function getSetupProgress(matchSetup) {
            if (!matchSetup) return 0;
            
            let configuredCount = 0;
            for (let i = 1; i <= 5; i++) {
                const matchKey = `match${i}`;
                if (matchSetup[matchKey] && 
                    matchSetup[matchKey].refereeEmail && 
                    matchSetup[matchKey].maxPoints && 
                    matchSetup[matchKey].numberOfSets && 
                    matchSetup[matchKey].courtNumber) {
                    configuredCount++;
                }
            }
            return configuredCount;
        }

        async function openMatchSetupModal(matchId) {
            currentMatch = matches.find(m => m._id === matchId);
            if (!currentMatch) {
                showAlert('Match not found!', 'error');
                return;
            }

            // Update match details
            document.getElementById('matchTitle').textContent = `Assign Match - Player Allocation`;
            document.getElementById('matchDetails').textContent = 
                `${currentMatch.college1Name} vs ${currentMatch.college2Name} | ${new Date(currentMatch.date).toLocaleDateString()} | ${currentMatch.time}`;

            // Generate player assignment grid based on match type
            generatePlayerAssignmentGrid(currentMatch);

            // Populate referee dropdown
            populateMainRefereeDropdown();

            // Show the setup form
            document.getElementById('setupForm').style.display = 'block';
            
            // Scroll to setup form
            document.getElementById('setupForm').scrollIntoView({ behavior: 'smooth' });
        }

        function updateCollegeNamesInForm() {
            // Update all college name elements
            document.getElementById('college1Name').textContent = currentMatch.college1Name;
            document.getElementById('college2Name').textContent = currentMatch.college2Name;
            document.getElementById('college1Name2').textContent = currentMatch.college1Name;
            document.getElementById('college2Name2').textContent = currentMatch.college2Name;
            document.getElementById('college1Name3').textContent = currentMatch.college1Name;
            document.getElementById('college2Name3').textContent = currentMatch.college2Name;
            document.getElementById('college1Name4').textContent = currentMatch.college1Name;
            document.getElementById('college2Name4').textContent = currentMatch.college2Name;
            document.getElementById('college1Name5').textContent = currentMatch.college1Name;
            document.getElementById('college2Name5').textContent = currentMatch.college2Name;
        }

        async function loadPlayersForMatch() {
            try {
                console.log('Loading players for match...', currentMatch.email1, currentMatch.email2);
                
                // Load players for college 1
                const response1 = await fetch(`/api/admin/college/${encodeURIComponent(currentMatch.email1)}/players`);
                console.log('College 1 response status:', response1.status);
                
                if (response1.ok) {
                    college1Players = await response1.json();
                    console.log('College 1 players loaded:', college1Players.length, college1Players);
                } else {
                    console.error('Failed to load college 1 players:', await response1.text());
                    college1Players = [];
                }
                
                // Load players for college 2
                const response2 = await fetch(`/api/admin/college/${encodeURIComponent(currentMatch.email2)}/players`);
                console.log('College 2 response status:', response2.status);
                
                if (response2.ok) {
                    college2Players = await response2.json();
                    console.log('College 2 players loaded:', college2Players.length, college2Players);
                } else {
                    console.error('Failed to load college 2 players:', await response2.text());
                    college2Players = [];
                }
                
                // Show alert about loaded players
                showAlert(`Loaded ${college1Players.length} players for ${currentMatch.college1Name} and ${college2Players.length} players for ${currentMatch.college2Name}`, 'info');
                
                // Populate all player dropdowns
                populateAllPlayerDropdowns();
                addPlayerSelectionListeners();
                
            } catch (error) {
                console.error('Error loading players:', error);
                showAlert('Error loading player data: ' + error.message, 'error');
                college1Players = [];
                college2Players = [];
            }
        }

        function populateAllPlayerDropdowns() {
            // Get currently selected players to exclude them from other dropdowns
            const selectedPlayers = getSelectedPlayerEmails();
            
            // Singles matches
            populatePlayerDropdownWithExclusions('match1_player1', college1Players, selectedPlayers);
            populatePlayerDropdownWithExclusions('match1_player2', college2Players, selectedPlayers);
            populatePlayerDropdownWithExclusions('match2_player1', college1Players, selectedPlayers);
            populatePlayerDropdownWithExclusions('match2_player2', college2Players, selectedPlayers);
            populatePlayerDropdownWithExclusions('match4_player1', college1Players, selectedPlayers);
            populatePlayerDropdownWithExclusions('match4_player2', college2Players, selectedPlayers);
            
            // Doubles matches
            populatePlayerDropdownWithExclusions('match3_team1_player1', college1Players, selectedPlayers);
            populatePlayerDropdownWithExclusions('match3_team1_player2', college1Players, selectedPlayers);
            populatePlayerDropdownWithExclusions('match3_team2_player1', college2Players, selectedPlayers);
            populatePlayerDropdownWithExclusions('match3_team2_player2', college2Players, selectedPlayers);
            populatePlayerDropdownWithExclusions('match5_team1_player1', college1Players, selectedPlayers);
            populatePlayerDropdownWithExclusions('match5_team1_player2', college1Players, selectedPlayers);
            populatePlayerDropdownWithExclusions('match5_team2_player1', college2Players, selectedPlayers);
            populatePlayerDropdownWithExclusions('match5_team2_player2', college2Players, selectedPlayers);
        }

        function populatePlayerDropdownWithExclusions(selectId, players, excludedPlayerEmails) {
            const select = document.getElementById(selectId);
            if (!select) return;
            
            // Get current selection to preserve it
            const currentValue = select.value;
            let currentPlayerEmail = null;
            
            if (currentValue && select.selectedIndex > 0) {
                // Get email from the selected option's data attribute
                const selectedOption = select.options[select.selectedIndex];
                if (selectedOption && selectedOption.getAttribute('data-email')) {
                    currentPlayerEmail = selectedOption.getAttribute('data-email');
                }
            }
            
            select.innerHTML = '<option value="">Select Player</option>';
            
            console.log(`Populating ${selectId} with ${players.length} players, excluding ${excludedPlayerEmails.size} selected players`);
            
            players.forEach(player => {
                const playerEmail = player.email;
                const playerName = player.playerName || player.name;
                
                // Show player if:
                // 1. Not already selected in another dropdown OR
                // 2. It's the currently selected player in this dropdown
                if (!excludedPlayerEmails.has(playerEmail) || playerEmail === currentPlayerEmail) {
                    const option = document.createElement('option');
                    // Use the player's ObjectId instead of JSON string
                    option.value = player._id;
                    option.textContent = playerName;
                    // Store additional data as data attributes for later use
                    option.setAttribute('data-name', playerName);
                    option.setAttribute('data-email', playerEmail);
                    
                    // Restore selection if it was the current player
                    if (playerEmail === currentPlayerEmail) {
                        option.selected = true;
                    }
                    
                    select.appendChild(option);
                }
            });
        }

        function getSelectedPlayerEmails() {
            const selectedPlayers = new Set();
            
            const allPlayerSelects = [
                'match1_player1', 'match1_player2',
                'match2_player1', 'match2_player2',
                'match3_team1_player1', 'match3_team1_player2', 
                'match3_team2_player1', 'match3_team2_player2',
                'match4_player1', 'match4_player2',
                'match5_team1_player1', 'match5_team1_player2', 
                'match5_team2_player1', 'match5_team2_player2'
            ];
            
            allPlayerSelects.forEach(selectId => {
                const select = document.getElementById(selectId);
                if (select && select.value) {
                    // Get email from the selected option's data attribute
                    const selectedOption = select.options[select.selectedIndex];
                    if (selectedOption && selectedOption.getAttribute('data-email')) {
                        selectedPlayers.add(selectedOption.getAttribute('data-email'));
                    }
                }
            });
            
            return selectedPlayers;
        }

        function populateRefereeDropdowns() {
            const refereeSelects = ['match1_referee', 'match2_referee', 'match3_referee', 'match4_referee', 'match5_referee'];
            
            refereeSelects.forEach(selectId => {
                const select = document.getElementById(selectId);
