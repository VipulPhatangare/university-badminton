        function displaySetupMatchCards() {
            const container = document.getElementById('setup-matches-container');
            
            // Filter for upcoming matches only that don't have complete setup
            const upcomingMatches = matches.filter(match => {
                const isUpcoming = match.matchStatus === 'upcoming' || 
                                 match.matchStatus === 'setup_required' ||
                                 !match.matchStatus;
                
                // Check if match setup is complete (has players allocated)
                const hasPlayersAllocated = match.match1Singles && 
                                          match.match1Singles.player1Name &&
                                          match.match2Singles && 
                                          match.match2Singles.player1Name &&
                                          match.match3Doubles &&
                                          match.match3Doubles.team1Player1Name &&
                                          match.match4Singles &&
                                          match.match4Singles.player1Name &&
                                          match.match5Doubles &&
                                          match.match5Doubles.team1Player1Name;
                
                return isUpcoming && !hasPlayersAllocated;
            });

            if (upcomingMatches.length === 0) {
                container.innerHTML = `
                    <div class="no-matches-card">
                        <i class="fas fa-check-circle"></i>
                        <h3>No Upcoming Matches Need Setup</h3>
                        <p>All upcoming matches have been configured or no upcoming matches found.</p>
                        <button onclick="refreshMatchCards()" class="btn btn-primary">
                            <i class="fas fa-sync-alt"></i> Refresh
                        </button>
                    </div>
                `;
                return;
            }

            container.innerHTML = upcomingMatches.map(match => createSetupMatchCard(match)).join('');
        }

        function createSetupMatchCard(match) {
            const hasPlayersAllocated = match.match1Singles && match.match1Singles.player1Name;
            const statusText = hasPlayersAllocated ? 'Setup Complete' : 'Setup Required';
            const statusClass = hasPlayersAllocated ? 'configured' : 'needs-setup';
            const statusBadgeClass = hasPlayersAllocated ? 'status-configured' : 'status-needs-setup';

            return `
                <div class="setup-match-card ${statusClass}" onclick="openMatchSetupModal('${match._id}')">
                    <div class="setup-match-header">
                        <h3>
                            <i class="fas fa-shuttle-van"></i>
                            ${match.college1Name} vs ${match.college2Name}
                        </h3>
                        <span class="setup-match-status ${statusBadgeClass}">${statusText}</span>
                    </div>
                    <div class="setup-match-info">
                        <p><strong>Match ID:</strong> ${match._id}</p>
                        <p><strong>Date:</strong> ${new Date(match.date).toLocaleDateString()}</p>
                        <p><strong>Time:</strong> ${match.time}</p>
                        <p><strong>Status:</strong> ${getMatchStatusText(match.matchStatus)}</p>
                        ${hasPlayersAllocated ? `
                            <p><strong>Progress:</strong> <span style="color: green;">✓ Players assigned</span></p>
                        ` : `
                            <p><strong>Progress:</strong> <span style="color: orange;">⚠ Needs configuration</span></p>
                        `}
                    </div>
                    <div class="setup-match-actions">
                        ${hasPlayersAllocated ? `
                            <button class="btn btn-success" disabled>
                                <i class="fas fa-check"></i> Setup Complete
                            </button>
                        ` : `
                            <button class="btn btn-primary">
                                <i class="fas fa-cog"></i> Configure Match & Players
                            </button>
                        `}
                    </div>
                </div>
            `;
        }

        function isMatchFullyConfigured(matchSetup) {
            if (!matchSetup) return false;
            
            // Check if all 5 matches have required configuration
            for (let i = 1; i <= 5; i++) {
                const matchKey = `match${i}`;
                if (!matchSetup[matchKey] || 
                    !matchSetup[matchKey].refereeEmail || 
                    !matchSetup[matchKey].maxPoints || 
                    !matchSetup[matchKey].numberOfSets || 
                    !matchSetup[matchKey].courtNumber) {
                    return false;
                }
            }
            return true;
        }

        function getSetupProgress(matchSetup) {
            if (!matchSetup) return 0;
            
            let configuredCount = 0;
            for (let i = 1; i <= 5; i++) {
                const matchKey = `match${i}`;
                if (matchSetup[matchKey] && 
                    matchSetup[matchKey].refereeEmail && 
                    matchSetup[matchKey].maxPoints && 
                    matchSetup[matchKey].numberOfSets && 
                    matchSetup[matchKey].courtNumber) {
                    configuredCount++;
                }
            }
            return configuredCount;
        }

