        function getStatusIcon(status) {
            switch(status) {
                case 'live': return '<i class="fas fa-play-circle"></i>';
                case 'complete': return '<i class="fas fa-check-circle"></i>';
                case 'upcoming': 
                default: return '<i class="fas fa-clock"></i>';
            }
        }
        
        function updateMatchCounts(matchesData) {
            const counts = {
                all: matchesData.length,
                upcoming: matchesData.filter(m => (m.matchStatus || 'upcoming') === 'upcoming').length,
                live: matchesData.filter(m => m.matchStatus === 'live').length,
                complete: matchesData.filter(m => m.matchStatus === 'complete').length
            };
            
            document.getElementById('allMatchesCount').textContent = counts.all;
            document.getElementById('upcomingCount').textContent = counts.upcoming;
            document.getElementById('liveCount').textContent = counts.live;
            document.getElementById('completedCount').textContent = counts.complete;
        }
        
        function setMatchFilter(status) {
            currentMatchFilter = status;
            
            // Update active button
            document.querySelectorAll('.filter-btn').forEach(btn => {
                btn.classList.remove('active');
            });
            document.querySelector(`[data-status="${status}"]`).classList.add('active');
            
            // Apply filter
            filterMatches();
        }
        
        function filterMatches() {
            const searchTerm = document.getElementById('matchesSearchInput').value.toLowerCase();
            const genderFilter = document.getElementById('genderFilter').value;
            
            let filteredMatches = allMatchesData;
            
            // Filter by status
            if (currentMatchFilter !== 'all') {
                filteredMatches = filteredMatches.filter(match => 
                    (match.matchStatus || 'upcoming') === currentMatchFilter
                );
            }
            
            // Filter by gender
            if (genderFilter !== 'all') {
                filteredMatches = filteredMatches.filter(match => match.gender === genderFilter);
            }
            
            // Filter by search term
            if (searchTerm) {
                filteredMatches = filteredMatches.filter(match => 
                    match.college1Name.toLowerCase().includes(searchTerm) ||
                    match.college2Name.toLowerCase().includes(searchTerm) ||
                    (match.matchStatus || 'upcoming').toLowerCase().includes(searchTerm) ||
                    (match.date || '').toLowerCase().includes(searchTerm) ||
                    (match.refreeName || '').toLowerCase().includes(searchTerm)
                );
            }
            
            displayMatches(filteredMatches);
        }
        
