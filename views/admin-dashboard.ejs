        // Function to populate player dropdowns
        function populatePlayerDropdowns(match) {
            if (!match || !allPlayers) {
                console.log('No match data or players available');
                return;
            }
            
            // Get team 1 and team 2 players
            const team1Players = allPlayers.filter(player => 
                player.email && (player.email === match.email1 || player.collegeEmail === match.email1)
            );
            const team2Players = allPlayers.filter(player => 
                player.email && (player.email === match.email2 || player.collegeEmail === match.email2)
            );
            
            console.log('Team 1 players:', team1Players);
            console.log('Team 2 players:', team2Players);
            
            // Update labels and headers with college names
            const college1Name = match.college1Name || 'College 1';
            const college2Name = match.college2Name || 'College 2';
            
            // Update singles match labels
            const singlesLabels = [
                'match1_college1_label', 'match1_college2_label',
                'match2_college1_label', 'match2_college2_label',
                'match4_college1_label', 'match4_college2_label'
            ];
            
            singlesLabels.forEach((labelId, index) => {
                const label = document.getElementById(labelId);
                if (label) {
                    const collegeName = index % 2 === 0 ? college1Name : college2Name;
                    label.textContent = `${collegeName} Player:`;
                }
            });
            
            // Update doubles match headers
            const doublesHeaders = [
                'match3_college1_header', 'match3_college2_header',
                'match5_college1_header', 'match5_college2_header'
            ];
            
            doublesHeaders.forEach((headerId, index) => {
                const header = document.getElementById(headerId);
                if (header) {
                    const collegeName = index % 2 === 0 ? college1Name : college2Name;
                    header.textContent = `${collegeName} Pair`;
                }
            });
            
            // Populate all player dropdowns
            document.querySelectorAll('.player-select').forEach(select => {
                const team = select.dataset.team;
                const players = team === '1' ? team1Players : team2Players;
                
                select.innerHTML = '<option value="">Select Player</option>';
                players.forEach(player => {
                    const option = document.createElement('option');
                    option.value = JSON.stringify({
                        id: player._id,
                        name: player.playerName,
                        email: player.email
                    });
                    option.textContent = player.playerName;
                    select.appendChild(option);
                });
            });
        }
        


