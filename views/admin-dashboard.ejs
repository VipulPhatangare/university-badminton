        function resetSetup() {
            // Reset match configuration
            for (let i = 1; i <= 5; i++) {
                const referee = document.getElementById(`match${i}_referee`);
                const maxPoints = document.getElementById(`match${i}_maxPoints`);
                const sets = document.getElementById(`match${i}_sets`);
                const court = document.getElementById(`match${i}_court`);
                
                if (referee) referee.value = '';
                if (maxPoints) maxPoints.value = '21';
                if (sets) sets.value = '3';
                if (court) court.value = '1';
            }
            
            // Reset player selections
            const allPlayerSelects = [
                'match1_player1', 'match1_player2',
                'match2_player1', 'match2_player2',
                'match3_team1_player1', 'match3_team1_player2', 
                'match3_team2_player1', 'match3_team2_player2',
                'match4_player1', 'match4_player2',
                'match5_team1_player1', 'match5_team1_player2', 
                'match5_team2_player1', 'match5_team2_player2'
            ];
            
            allPlayerSelects.forEach(selectId => {
                const select = document.getElementById(selectId);
