        // Schedule Generator Functions
        function initScheduleGenerator() {
            // Setup gender toggle
            const boysToggle = document.getElementById('boys-toggle');
            const girlsToggle = document.getElementById('girls-toggle');
            const boysSchedule = document.getElementById('boys-schedule');
            const girlsSchedule = document.getElementById('girls-schedule');

            if (boysToggle && girlsToggle) {
                boysToggle.addEventListener('click', function() {
                    boysToggle.classList.add('active');
                    girlsToggle.classList.remove('active');
                    boysSchedule.style.display = 'block';
                    girlsSchedule.style.display = 'none';
                });

                girlsToggle.addEventListener('click', function() {
                    girlsToggle.classList.add('active');
                    boysToggle.classList.remove('active');
                    girlsSchedule.style.display = 'block';
                    boysSchedule.style.display = 'none';
                });
            }

            // Initialize time slots for all rounds
            populateTimeSlots();
            
            // Load colleges for each round when page loads
            loadCollegesForSchedule();
        }

        function populateTimeSlots() {
            const rounds = ['round1', 'round2', 'quarter', 'semi', 'final'];
            rounds.forEach(round => {
                const timeSelect = document.getElementById(`${round}-time`);
                if (timeSelect) {
                    timeSelect.innerHTML = '';
                    for (let hour = 8; hour <= 20; hour++) {
                        const time12 = hour > 12 ? `${hour - 12}:00 PM` : `${hour}:00 AM`;
                        const time24 = `${hour.toString().padStart(2, '0')}:00`;
                        
                        const option = document.createElement('option');
                        option.value = time24;
                        option.textContent = time12;
                        timeSelect.appendChild(option);
                    }
                }
            });
        }

