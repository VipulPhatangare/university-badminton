        function populateAllPlayerDropdowns() {
            // Get currently selected players to exclude them from other dropdowns
            const selectedPlayers = getSelectedPlayerEmails();
            
            // Singles matches
            populatePlayerDropdownWithExclusions('match1_player1', college1Players, selectedPlayers);
            populatePlayerDropdownWithExclusions('match1_player2', college2Players, selectedPlayers);
            populatePlayerDropdownWithExclusions('match2_player1', college1Players, selectedPlayers);
            populatePlayerDropdownWithExclusions('match2_player2', college2Players, selectedPlayers);
            populatePlayerDropdownWithExclusions('match4_player1', college1Players, selectedPlayers);
            populatePlayerDropdownWithExclusions('match4_player2', college2Players, selectedPlayers);
            
            // Doubles matches
            populatePlayerDropdownWithExclusions('match3_team1_player1', college1Players, selectedPlayers);
            populatePlayerDropdownWithExclusions('match3_team1_player2', college1Players, selectedPlayers);
            populatePlayerDropdownWithExclusions('match3_team2_player1', college2Players, selectedPlayers);
            populatePlayerDropdownWithExclusions('match3_team2_player2', college2Players, selectedPlayers);
            populatePlayerDropdownWithExclusions('match5_team1_player1', college1Players, selectedPlayers);
            populatePlayerDropdownWithExclusions('match5_team1_player2', college1Players, selectedPlayers);
            populatePlayerDropdownWithExclusions('match5_team2_player1', college2Players, selectedPlayers);
            populatePlayerDropdownWithExclusions('match5_team2_player2', college2Players, selectedPlayers);
