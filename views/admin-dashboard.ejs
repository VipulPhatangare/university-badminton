        async function savePlayer() {
            const form = document.getElementById('playerForm');
            const formData = new FormData(form);
            
            const playerData = {
                playerName: formData.get('playerName'),
                email: formData.get('email'),
                phone: formData.get('phone'),
                gender: formData.get('gender'),
                collegeId: formData.get('collegeId')
            };
            
            // Debug logging
            console.log('Player Data being sent:', playerData);
            console.log('Current College Data:', currentCollegeData);
            
            // Validate required fields
            if (!playerData.playerName || !playerData.email) {
                showAlert('Please fill in all required fields', 'error');
                return;
            }
            
            // Additional validation
            if (!playerData.gender) {
                showAlert('Gender is required', 'error');
                return;
            }
            
            if (!playerData.collegeId) {
                showAlert('College ID is missing', 'error');
                return;
            }
            
            try {
                let url, method;
                
                if (currentPlayerAction === 'add') {
                    url = '/api/admin/players';
                    method = 'POST';
                } else {
                    const playerId = formData.get('playerId');
                    url = `/api/admin/players/${playerId}`;
                    method = 'PUT';
                }
                
                const response = await fetch(url, {
                    method: method,
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(playerData)
                });
                
                const result = await response.json();
                
                if (result.success) {
                    const actionText = currentPlayerAction === 'add' ? 'added' : 'updated';
                    showAlert(`Player ${actionText} successfully!`, 'success');
                    
                    closePlayerModal();
                    
                    // Refresh the college modal data
                    await openCollegeDetailsModal(currentCollegeData.college._id);
                    
                    // Refresh the colleges list
                    await loadColleges();
                } else {
                    // Handle specific error messages
                    let errorMessage = result.error || 'Unknown error occurred';
                    
                    if (errorMessage.includes('already exists') || errorMessage.includes('duplicate') || errorMessage.includes('E11000')) {
                        errorMessage = 'A player with this email already exists. Please use a different email address.';
                    } else if (errorMessage.includes('validation failed')) {
                        errorMessage = 'Please fill in all required fields correctly.';
                    }
                    
                    showAlert(errorMessage, 'error');
                }
            } catch (error) {
                console.error('Error saving player:', error);
                showAlert('Error saving player', 'error');
            }
        }

