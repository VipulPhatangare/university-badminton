        // Update statistics
        function updateStatistics() {
            const total = matches.length;
            const upcoming = matches.filter(m => ['upcoming', 'setup_completed', 'players_allocated'].includes(m.matchStatus)).length;
            const live = matches.filter(m => m.matchStatus === 'live').length;
            const completed = matches.filter(m => m.matchStatus === 'complete').length;

            document.getElementById('totalMatches').textContent = total;
            document.getElementById('upcomingMatches').textContent = upcoming;
            document.getElementById('liveMatches').textContent = live;
            document.getElementById('completedMatches').textContent = completed;
        }

        // Load recent activity
        function loadRecentActivity() {
            const activityContainer = document.getElementById('recent-activity');
            const recentMatches = matches
                .filter(m => m.matchStatus !== 'upcoming')
                .sort((a, b) => new Date(b.date) - new Date(a.date))
                .slice(0, 5);

            if (recentMatches.length === 0) {
                activityContainer.innerHTML = '<p class="text-center text-muted">No recent activity</p>';
                return;
            }

            activityContainer.innerHTML = recentMatches.map(match => `
                <div class="activity-item">
                    <div class="activity-icon">
                        <i class="fas fa-${getActivityIcon(match.matchStatus)}"></i>
                    </div>
                    <div class="activity-content">
                        <strong>${match.college1Name} vs ${match.college2Name}</strong>
                        <div class="activity-time">${getActivityText(match)}</div>
                    </div>
                </div>
            `).join('');
        }

        function getActivityIcon(status) {
            const icons = {
                'live': 'play-circle',
                'complete': 'check-circle',
                'setup_completed': 'cogs',
                'players_allocated': 'users'
            };
            return icons[status] || 'clock';
        }

        function getActivityText(match) {
            const statusTexts = {
                'live': 'Match is currently live',
                'complete': 'Match completed',
                'setup_completed': 'Setup completed, awaiting player allocation',
                'players_allocated': 'Players allocated, ready to start'
            };
            return statusTexts[match.matchStatus] || 'Status updated';
        }

