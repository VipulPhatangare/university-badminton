        function addPlayerSelectionListeners() {
            const allPlayerSelects = [
                'match1_player1', 'match1_player2',
                'match2_player1', 'match2_player2',
                'match3_team1_player1', 'match3_team1_player2', 
                'match3_team2_player1', 'match3_team2_player2',
                'match4_player1', 'match4_player2',
                'match5_team1_player1', 'match5_team1_player2', 
                'match5_team2_player1', 'match5_team2_player2'
            ];
            
            allPlayerSelects.forEach(selectId => {
                const select = document.getElementById(selectId);
                if (select) {
                    select.addEventListener('change', function() {
                        // Refresh all dropdowns when any selection changes
                        // This will remove/add players based on current selections
                        populateAllPlayerDropdowns();
                        
                        // Also validate for conflicts
                        validatePlayerSelections();
                    });
                }
            });
        }

        function validatePlayerSelections() {
            const selectedPlayers = new Set();
            let hasConflicts = false;
            
            const allPlayerSelects = [
                'match1_player1', 'match1_player2',
                'match2_player1', 'match2_player2',
                'match3_team1_player1', 'match3_team1_player2', 
                'match3_team2_player1', 'match3_team2_player2',
                'match4_player1', 'match4_player2',
                'match5_team1_player1', 'match5_team1_player2', 
                'match5_team2_player1', 'match5_team2_player2'
            ];
            
            // Reset all borders first
            allPlayerSelects.forEach(selectId => {
                const select = document.getElementById(selectId);
                if (select) {
                    select.style.borderColor = '';
                }
            });
            
            // Check for duplicates (shouldn't happen with our filtering, but good to check)
            allPlayerSelects.forEach(selectId => {
                const select = document.getElementById(selectId);
                if (select && select.value) {
                    try {
                        const playerData = JSON.parse(select.value);
                        if (selectedPlayers.has(playerData.email)) {
                            hasConflicts = true;
                            select.style.borderColor = 'red';
                            console.warn(`Duplicate player selection detected: ${playerData.name} in ${selectId}`);
                        } else {
                            selectedPlayers.add(playerData.email);
                        }
                    } catch (e) {
                        console.error('Error parsing player data:', e);
                    }
                }
            });
            
            return !hasConflicts;
        }

