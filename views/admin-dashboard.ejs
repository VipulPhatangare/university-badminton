                    // Remove the match from the assignment grid with animation
                    const matchCard = document.querySelector(`[data-match-id="${currentMatch._id}"]`);
                    if (matchCard) {
                        matchCard.style.animation = 'fadeOut 0.5s ease-out';
                        setTimeout(() => {
                            matchCard.remove();
                        }, 500);
                    }
                    
                    // Show the matches container again
                    const matchesContainer = document.getElementById('setup-matches-container');
                    if (matchesContainer) {
                        matchesContainer.style.display = 'grid';
                    }
                    
                    // Clear current match
                    currentMatch = null;
                    
                    // Refresh the matches list to get updated data
                    setTimeout(() => {
                        refreshMatchCards();
                        loadAllMatches(); // Also refresh the main matches view
                    }, 600);
                    
                } else {
                    showAlert('Error saving match setup: ' + (result.error || result.message || 'Unknown error'), 'error');
                }
            } catch (error) {
                console.error('Error saving match setup:', error);
                showAlert('Error saving match setup: ' + error.message, 'error');
            }
        }
        
