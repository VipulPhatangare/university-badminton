        function loadMatchForSetup() {
            const matchId = document.getElementById('matchSelect').value;
            const setupForm = document.getElementById('setupForm');
            
            if (!matchId) {
                setupForm.style.display = 'none';
                return;
            }

            currentMatch = matches.find(m => m._id === matchId);
