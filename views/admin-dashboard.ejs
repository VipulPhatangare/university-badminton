<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - Badminton Tournament</title>
    <link rel="icon" type="image/png" href="/assets/badminton-shuttle-1000x1000-removebg-preview.png">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        /* Enhanced CSS with homepage color scheme and fonts */
        @font-face {
            font-family: 'font1';
            src: url("/fonts/BwGradualDEMO-Medium.otf") format("opentype");
        }
        @font-face {
            font-family: "panchang";
            src: url("/fonts/Panchang-Variable.ttf") format("truetype");
        }
        @import url('https://fonts.googleapis.com/css2?family=Titillium+Web:ital,wght@0,200;0,300;0,400;0,600;0,700;0,900;1,200;1,300;1,400;1,600;1,700&display=swap');
        
        :root {
            --primary-blue: #1565c0;
            --dark-blue: #0d47a1;
            --light-blue: #1976d2;
            --accent-blue: #2196f3;
            --bg-light: #e3f2fd;
            --white: #ffffff;
            --light-gray: #f8f9fa;
            --gray: #6c757d;
            --dark-gray: #2c3e50;
            --text-dark: #1a1a1a;
            --text-secondary: #495057;
            --accent-gold: #FFD700;
            --success: #28a745;
            --warning: #ffc107;
            --danger: #dc3545;
            --shadow-light: 0 2px 10px rgba(21, 101, 192, 0.1);
            --shadow-medium: 0 4px 20px rgba(21, 101, 192, 0.15);
            --shadow-heavy: 0 8px 30px rgba(21, 101, 192, 0.25);
            --gradient-blue: linear-gradient(135deg, #1565c0 0%, #1976d2 50%, #0d47a1 100%);
            --gradient-light: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%);
            --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            --transition-fast: all 0.2s ease;
            --border-radius: 12px;
            --border-radius-lg: 20px;
            
            /* Additional variables for layout */
            --sidebar-width: 250px;
            --header-height: 70px;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Titillium Web', sans-serif;
        }

        body {
            background-color: var(--bg-light);
            color: var(--dark-gray);
            line-height: 1.6;
            min-height: 100vh;
            position: relative;
            font-family: 'Titillium Web', sans-serif;
        }

        /* Sidebar */
        .sidebar {
            width: var(--sidebar-width);
            background: var(--gradient-blue);
            color: var(--white);
            position: fixed;
            height: 100vh;
            overflow-y: auto;
            transition: var(--transition);
            z-index: 1000;
            left: 0;
            box-shadow: var(--shadow-medium);
        }

        .main-content {
            margin-left: var(--sidebar-width);
            width: calc(100% - var(--sidebar-width));
            transition: var(--transition);
        }

        @media (max-width: 768px) {
            .sidebar {
                left: -250px;
            }
            .sidebar.active {
                left: 0;
            }
            .main-content {
                margin-left: 0;
                width: 100%;
            }
            .main-content.sidebar-active {
                margin-left: var(--sidebar-width);
            }
        }

        .sidebar-header {
            padding: 20px;
            text-align: center;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        .sidebar-header .logo {
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'font1', sans-serif;
            font-weight: 700;
            font-size: 1.5rem;
        }

        .logo i {
            margin-right: 10px;
            color: var(--accent-gold);
            animation: pulse 2s infinite;
        }

        .sidebar-menu {
            padding: 20px 0;
        }

        .menu-item {
            padding: 12px 20px;
            display: flex;
            align-items: center;
            cursor: pointer;
            transition: var(--transition);
            border-left: 4px solid transparent;
            position: relative;
            overflow: hidden;
        }

        .menu-item::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
            transition: var(--transition);
        }

        .menu-item:hover::before {
            left: 100%;
        }

        .menu-item:hover {
            background-color: rgba(255, 255, 255, 0.1);
            transform: translateX(5px);
        }

        .menu-item.active {
            background-color: rgba(255, 255, 255, 0.15);
            border-left-color: var(--accent-gold);
        }

        .menu-item i {
            margin-right: 15px;
            width: 20px;
            text-align: center;
        }

        /* Main Content */
        .main-content {
            position: relative;
        }

        /* Header */
        .header {
            background: var(--gradient-blue);
            height: var(--header-height);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 30px;
            box-shadow: var(--shadow-medium);
            position: sticky;
            top: 0;
            z-index: 100;
            flex-wrap: nowrap;
            color: var(--white);
        }

        .page-title {
            font-family: 'panchang', sans-serif;
            font-size: 1.5rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .header-actions {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .user-menu {
            display: flex;
            align-items: center;
            gap: 10px;
            cursor: pointer;
            position: relative;
        }

        .user-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background-color: var(--accent-gold);
            color: var(--dark-red);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            transition: var(--transition);
        }

        .user-avatar:hover {
            transform: scale(1.1);
        }

        /* Content Area */
        .content {
            padding: 30px;
        }

        /* Section Styles */
        .section {
            background-color: var(--white);
            border-radius: var(--border-radius);
            padding: 25px;
            box-shadow: var(--shadow-light);
            margin-bottom: 30px;
            transition: var(--transition);
        }

        .section:hover {
            box-shadow: var(--shadow-medium);
        }

        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            padding-bottom: 15px;
            border-bottom: 1px solid #eee;
        }

        .section-title {
            font-family: 'panchang', sans-serif;
            font-size: 1.4rem;
            color: var(--primary-blue);
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .section-actions {
            display: flex;
            gap: 15px;
            align-items: center;
            flex-wrap: wrap;
        }

        .btn {
            padding: 8px 16px;
            border: none;
            border-radius: var(--border-radius);
            cursor: pointer;
            font-weight: 600;
            transition: var(--transition);
            position: relative;
            overflow: hidden;
        }

        .btn-primary {
            background-color: var(--primary-blue);
            color: var(--white);
            border: 1px solid var(--primary-blue);
        }

        .btn-primary:hover {
            background-color: var(--dark-blue);
            border-color: var(--dark-blue);
            transform: translateY(-2px);
        }

        /* Search Box */
        .search-box {
            position: relative;
            min-width: 300px;
            flex: 1;
            max-width: 400px;
        }

        .search-box input {
            width: 100%;
            padding: 10px 15px 10px 40px;
            border: 2px solid #e9ecef;
            border-radius: var(--border-radius);
            font-size: 0.95rem;
            transition: var(--transition);
            background-color: var(--white);
        }

        .search-box .search-icon {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--gray);
            font-size: 1rem;
        }

        .search-box input:focus {
            outline: none;
            border-color: var(--primary-blue);
            box-shadow: 0 0 0 3px rgba(21, 101, 192, 0.1);
        }

        .search-box input::placeholder {
            color: var(--gray);
            font-style: italic;
        }

        /* Match Cards */
        .match-cards {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 20px;
        }

        .match-card {
            background-color: var(--white);
            border-radius: var(--border-radius);
            box-shadow: var(--shadow-light);
            overflow: hidden;
            transition: var(--transition);
            cursor: pointer;
            animation: fadeIn 0.5s ease-out;
        }

        .match-card:hover {
            transform: translateY(-5px);
            box-shadow: var(--shadow-medium);
        }

        .match-card-header {
            background: var(--gradient-blue);
            color: var(--white);
            padding: 15px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .match-number {
            font-weight: 700;
            font-size: 1.2rem;
        }

        .match-round {
            background-color: var(--accent-gold);
            color: var(--dark-blue);
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 600;
        }

        .match-card-body {
            padding: 15px;
        }

        .match-teams {
            margin-bottom: 15px;
            text-align: center;
        }

        .team {
            font-size: 1.1rem;
            font-weight: 600;
            margin-bottom: 5px;
            color: var(--dark-gray);
        }

        .vs-text {
            font-size: 1.5rem;
            color: var(--primary-blue);
            font-weight: 700;
            margin: 10px 0;
        }

        .match-details {
            display: flex;
            justify-content: space-between;
            color: var(--gray);
            font-size: 0.9rem;
            border-top: 1px solid #eee;
            padding-top: 10px;
        }

        .match-info {
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .logout-btn {
            background-color: var(--danger);
            color: var(--white);
            border: none;
            padding: 10px 20px;
            border-radius: var(--border-radius);
            cursor: pointer;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: var(--transition);
            margin-top: 20px;
            width: calc(100% - 40px);
            margin-left: 20px;
            margin-right: 20px;
            justify-content: center;
            box-shadow: var(--shadow-light);
        }

        .logout-btn:hover {
            background-color: #c82333;
            transform: translateY(-2px);
        }

        /* Toggle for mobile sidebar */
        .menu-toggle {
            display: none;
            font-size: 1.5rem;
            cursor: pointer;
            margin-left: auto;
            transition: var(--transition);
        }

        .menu-toggle:hover {
            color: var(--accent-gold);
        }

        @media (max-width: 768px) {
            .menu-toggle {
                display: block;
                order: 2;
                position: absolute;
                right: 20px;
            }
            .header {
                justify-content: center;
                position: relative;
            }
            .page-title {
                order: 1;
                text-align: center;
            }
            .header-actions {
                order: 3;
            }
            .sidebar {
                left: -250px;
            }
            .sidebar.active {
                left: 0;
            }
            
            .match-cards {
                grid-template-columns: 1fr;
            }
        }

        /* Overlay for when sidebar is open */
        .overlay {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: rgba(0, 0, 0, 0.5);
            z-index: 999;
            display: none;
        }

        .overlay.active {
            display: block;
        }

        /* Modal backdrop click handler */
        .modal {
            cursor: pointer;
        }

        .modal-content {
            cursor: default;
        }

        /* Animations */
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @keyframes pulse {
            0% { transform: scale(1); }
            50% { transform: scale(1.1); }
            100% { transform: scale(1); }
        }

        /* Badminton shuttlecock icon animation */
        .shuttlecock {
            display: inline-block;
            animation: float 3s ease-in-out infinite;
        }

        @keyframes float {
            0% { transform: translateY(0px); }
            50% { transform: translateY(-10px); }
            100% { transform: translateY(0px); }
        }

        /* No matches message */
        .no-matches {
            text-align: center;
            padding: 40px 20px;
            color: var(--gray);
        }

        .no-matches i {
            font-size: 3rem;
            margin-bottom: 15px;
            color: var(--primary-blue);
            opacity: 0.5;
        }

        .no-matches h3 {
            margin-bottom: 10px;
            font-size: 1.2rem;
        }

        /* Admin Dashboard Specific Styles */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .stat-card {
            background: var(--gradient-blue);
            color: var(--white);
            padding: 25px;
            border-radius: var(--border-radius);
            box-shadow: var(--shadow-medium);
            display: flex;
            align-items: center;
            gap: 20px;
            transition: var(--transition);
        }

        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: var(--shadow-heavy);
        }

        .stat-icon {
            font-size: 2.5rem;
            opacity: 0.8;
        }

        .stat-content h3 {
            font-size: 2rem;
            margin-bottom: 5px;
            font-weight: 700;
        }

        .stat-content p {
            opacity: 0.9;
            font-size: 1rem;
        }

        /* Match Setup Styles */
        .matches-section {
            margin-bottom: 30px;
        }

        .section-info {
            margin-bottom: 25px;
        }

        .setup-match-card {
            background: var(--white);
            border-radius: var(--border-radius-lg);
            padding: 25px;
            box-shadow: var(--shadow-medium);
            transition: var(--transition);
            cursor: pointer;
            border: 2px solid transparent;
        }

        .setup-match-card:hover {
            transform: translateY(-5px);
            box-shadow: var(--shadow-heavy);
            border-color: var(--primary-blue);
        }

        .setup-match-card.needs-setup {
            border-left: 4px solid var(--warning);
            background: linear-gradient(135deg, #fff 0%, #fff9e6 100%);
        }

        .setup-match-card.configured {
            border-left: 4px solid var(--success);
            background: linear-gradient(135deg, #fff 0%, #f0fff0 100%);
            opacity: 0.7;
            pointer-events: none;
        }

        .setup-match-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            padding-bottom: 15px;
            border-bottom: 2px solid var(--light-gray);
        }

        .setup-match-header h3 {
            color: var(--dark-gray);
            font-size: 1.4rem;
            font-weight: 700;
            margin: 0;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .setup-match-status {
            padding: 8px 15px;
            border-radius: 25px;
            font-weight: 600;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .status-needs-setup {
            background: linear-gradient(135deg, #ffc107, #ffb300);
            color: white;
        }

        .status-configured {
            background: linear-gradient(135deg, #28a745, #20c997);
            color: white;
        }

        .setup-match-info {
            margin-bottom: 20px;
        }

        .setup-match-info p {
            margin: 8px 0;
            color: var(--gray);
            font-weight: 500;
        }

        .setup-match-info strong {
            color: var(--dark-gray);
            font-weight: 700;
        }

        .setup-match-actions {
            display: flex;
            gap: 15px;
            margin-top: 20px;
        }

        .loading-card {
            grid-column: 1 / -1;
            text-align: center;
            padding: 60px 20px;
            background: var(--white);
            border-radius: var(--border-radius-lg);
            box-shadow: var(--shadow-light);
        }

        .loading-card i {
            font-size: 3rem;
            color: var(--primary-blue);
            margin-bottom: 20px;
        }

        .loading-card h3 {
            color: var(--dark-gray);
            margin-bottom: 10px;
        }

        .no-matches-card {
            grid-column: 1 / -1;
            text-align: center;
            padding: 60px 20px;
            background: var(--light-gray);
            border-radius: var(--border-radius-lg);
            border: 2px dashed var(--gray);
        }

        /* Player Assignment Styles */
        .progress-indicator {
            display: flex;
            justify-content: center;
            margin: 30px 0;
        }

        .progress-step {
            padding: 10px 20px;
            margin: 0 5px;
            border-radius: 20px;
            background: #e9ecef;
            color: #6c757d;
            font-weight: 500;
            font-size: 0.9rem;
        }

        .progress-step.active {
            background: var(--primary-blue);
            color: white;
        }

        .player-assignment-section {
            background: #f8f9fa;
            border-radius: 10px;
            padding: 20px;
            margin-top: 20px;
            border: 1px solid #e9ecef;
        }

        .player-assignment-section h5 {
            color: var(--primary-blue);
            margin-bottom: 15px;
            font-weight: 600;
            text-align: center;
        }

        .team-selection {
            display: grid;
            grid-template-columns: 1fr auto 1fr;
            gap: 20px;
            align-items: center;
        }

        .doubles-selection {
            display: grid;
            grid-template-columns: 1fr auto 1fr;
            gap: 20px;
            align-items: center;
        }

        .team-section {
            background: white;
            padding: 15px;
            border-radius: 8px;
            border: 1px solid #e9ecef;
        }

        .team-section h6 {
            color: var(--dark-gray);
            margin-bottom: 10px;
            text-align: center;
            font-weight: 600;
            font-size: 1rem;
        }

        .doubles-players {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .vs-divider {
            font-weight: bold;
            font-size: 1.2rem;
            color: var(--primary-blue);
            background: white;
            padding: 10px 15px;
            border-radius: 20px;
            border: 2px solid var(--primary-blue);
            text-align: center;
        }

        .player-select {
            width: 100%;
            padding: 10px;
            border: 1px solid #ddd;
            border-radius: 6px;
            font-size: 0.9rem;
        }

        .player-select:focus {
            outline: none;
            border-color: var(--primary-blue);
            box-shadow: 0 0 0 2px rgba(231, 76, 60, 0.1);
        }

        .no-matches-card i {
            font-size: 4rem;
            color: var(--gray);
            margin-bottom: 20px;
        }

        .no-matches-card h3 {
            color: var(--dark-gray);
            margin-bottom: 10px;
        }

        .match-selection {
            background: var(--light-gray);
            padding: 20px;
            border-radius: var(--border-radius);
            margin-bottom: 30px;
        }

        .match-selection label {
            font-weight: 600;
            color: var(--dark-gray);
            margin-bottom: 10px;
            display: block;
        }

        .matches-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
            gap: 25px;
            margin: 30px 0;
        }

        .match-config-card {
            background: var(--white);
            border-radius: var(--border-radius);
            padding: 25px;
            box-shadow: var(--shadow-light);
            border: 2px solid transparent;
            transition: var(--transition);
        }

        .match-config-card:hover {
            border-color: var(--primary-blue);
            transform: translateY(-3px);
            box-shadow: var(--shadow-medium);
        }

        .match-config-card h4 {
            color: var(--primary-blue);
            font-size: 1.2rem;
            margin-bottom: 20px;
            padding-bottom: 10px;
            border-bottom: 2px solid var(--light-gray);
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .config-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
        }

        .config-item {
            margin-bottom: 15px;
        }

        .config-item label {
            display: block;
            font-weight: 600;
            color: var(--dark-gray);
            margin-bottom: 5px;
            font-size: 0.9rem;
        }

        .form-control {
            width: 100%;
            padding: 10px 12px;
            border: 2px solid #e9ecef;
            border-radius: 6px;
            font-size: 0.95rem;
            transition: var(--transition);
        }

        .form-control:focus {
            outline: none;
            border-color: var(--primary-blue);
            box-shadow: 0 0 0 3px rgba(178, 34, 34, 0.1);
        }

        .referee-select {
            background: linear-gradient(45deg, #fff 0%, #f8f9fa 100%);
        }

        .setup-actions {
            text-align: center;
            margin: 30px 0;
            padding: 20px;
            background: var(--light-gray);
            border-radius: var(--border-radius);
        }

        .setup-actions .btn {
            margin: 0 10px;
            padding: 12px 25px;
            font-size: 1rem;
        }

        .setup-header {
            background: var(--gradient-blue);
            color: var(--white);
            padding: 20px;
            border-radius: var(--border-radius);
            margin-bottom: 30px;
            text-align: center;
        }

        .setup-header h3 {
            font-family: 'panchang', sans-serif;
            font-size: 1.5rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 10px;
        }

        .assigned-referees-section {
            background: var(--light-gray);
            padding: 20px;
            border-radius: var(--border-radius);
            margin-top: 30px;
        }

        .assigned-referees-section h4 {
            color: var(--primary-blue);
            margin-bottom: 15px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .referees-list {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }

        .referee-badge {
            background: var(--primary-blue);
            color: var(--white);
            padding: 8px 15px;
            border-radius: 20px;
            font-size: 0.9rem;
            font-weight: 500;
        }

        /* Table Styles */
        .table-container {
            overflow-x: auto;
            border-radius: var(--border-radius);
            box-shadow: var(--shadow-light);
        }

        .data-table {
            width: 100%;
            border-collapse: collapse;
            background: var(--white);
        }

        .data-table thead {
            background: var(--gradient-blue);
            color: var(--white);
        }

        .data-table th,
        .data-table td {
            padding: 15px 12px;
            text-align: left;
            border-bottom: 1px solid #eee;
