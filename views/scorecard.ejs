<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Match Scorecard - Badminton Tournament</title>
    <link rel="icon" type="image/png" href="/assets/badminton-shuttle-1000x1000-removebg-preview.png">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        /* Use same CSS variables */
        :root {
            --primary-red: #B22222;
            --dark-red: #8B0000;
            --light-red: #DC143C;
            --white: #ffffff;
            --light-gray: #f8f9fa;
            --gray: #6c757d;
            --dark-gray: #343a40;
            --accent-gold: #FFD700;
            --success: #28a745;
            --warning: #ffc107;
            --danger: #dc3545;
            --shadow-light: 0 2px 10px rgba(178, 34, 34, 0.1);
            --shadow-medium: 0 4px 20px rgba(178, 34, 34, 0.15);
            --shadow-heavy: 0 8px 30px rgba(178, 34, 34, 0.25);
            --gradient-red: linear-gradient(135deg, #B22222 0%, #DC143C 50%, #8B0000 100%);
            --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            --border-radius: 12px;
            --border-radius-lg: 20px;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: var(--light-gray);
            color: var(--dark-gray);
            line-height: 1.6;
            min-height: 100vh;
        }

        /* Header */
        .header {
            background: var(--gradient-red);
            color: var(--white);
            padding: 20px;
            box-shadow: var(--shadow-medium);
        }

        .header-content {
            max-width: 1200px;
            margin: 0 auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .back-btn {
            background: rgba(255, 255, 255, 0.2);
            border: none;
            color: var(--white);
            padding: 10px 20px;
            border-radius: var(--border-radius);
            cursor: pointer;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: var(--transition);
        }

        .back-btn:hover {
            background: rgba(255, 255, 255, 0.3);
        }

        .match-title {
            text-align: center;
            flex: 1;
        }

        .match-number {
            font-size: 1.5rem;
            font-weight: 600;
            margin-bottom: 5px;
        }

        .match-type {
            font-size: 1rem;
            opacity: 0.9;
        }

        /* Content */
        .content {
            max-width: 1200px;
            margin: 0 auto;
            padding: 30px 20px;
        }

        .scorecard {
            background: var(--white);
            border-radius: var(--border-radius-lg);
            box-shadow: var(--shadow-medium);
            overflow: hidden;
            margin-bottom: 30px;
        }

        .match-info {
            background: var(--light-gray);
            padding: 20px;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 20px;
            text-align: center;
        }

        .info-item {
            display: flex;
            flex-direction: column;
        }

        .info-label {
            font-size: 0.9rem;
            color: var(--gray);
            margin-bottom: 5px;
        }

        .info-value {
            font-size: 1.2rem;
            font-weight: 600;
            color: var(--primary-red);
        }

        .players-section {
            padding: 30px;
        }

        .players-container {
            display: grid;
            grid-template-columns: 1fr auto 1fr;
            gap: 30px;
            align-items: center;
            margin-bottom: 30px;
        }

        .player-card {
            background: var(--light-gray);
            border-radius: var(--border-radius);
            padding: 30px 20px;
            text-align: center;
            position: relative;
            transition: var(--transition);
            min-height: 200px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .player-card.active {
            background: rgba(178, 34, 34, 0.1);
            border: 2px solid var(--primary-red);
            transform: scale(1.02);
        }

        .service-indicator {
            position: absolute;
            top: 15px;
            right: 15px;
            background: var(--primary-red);
            color: var(--white);
            width: 30px;
            height: 30px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.8rem;
            animation: servicePulse 2s infinite;
        }

        .player-name {
            font-size: 1.2rem;
            font-weight: 600;
            margin-bottom: 15px;
            color: var(--dark-gray);
        }

        .player-score {
            font-size: 3.5rem;
            font-weight: 700;
            color: var(--primary-red);
            margin-bottom: 20px;
            transition: var(--transition);
        }

        .score-change {
            animation: scoreBounce 0.5s ease;
        }

        .score-controls {
            display: flex;
            gap: 10px;
            justify-content: center;
        }

        .score-btn {
            background: var(--primary-red);
            color: var(--white);
            border: none;
            border-radius: 50%;
            width: 50px;
            height: 50px;
            font-size: 1.2rem;
            cursor: pointer;
            transition: var(--transition);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .score-btn:hover {
            background: var(--dark-red);
            transform: scale(1.1);
        }

        .score-btn:disabled {
            background: var(--gray);
            cursor: not-allowed;
            transform: none;
        }

        .vs-divider {
            font-size: 2.5rem;
            font-weight: 700;
            color: var(--primary-red);
        }

        .game-status {
            text-align: center;
            margin-bottom: 20px;
        }

        .status-message {
            padding: 15px;
            border-radius: var(--border-radius);
            font-weight: 600;
            margin-bottom: 15px;
        }

        .advantage {
            background: rgba(255, 193, 7, 0.2);
            color: var(--warning);
            border: 1px solid var(--warning);
        }

        .game-point {
            background: rgba(220, 53, 69, 0.2);
            color: var(--danger);
            border: 1px solid var(--danger);
        }

        .match-complete {
            background: rgba(40, 167, 69, 0.2);
            color: var(--success);
            border: 1px solid var(--success);
        }

        .sets-section {
            border-top: 1px solid #eee;
            padding-top: 20px;
        }

        .sets-title {
            text-align: center;
            font-size: 1.1rem;
            font-weight: 600;
            margin-bottom: 15px;
            color: var(--primary-red);
        }

        .sets-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
            gap: 15px;
            margin-bottom: 20px;
        }

        .set-card {
            background: var(--white);
            border: 1px solid #ddd;
            border-radius: var(--border-radius);
            padding: 15px;
            text-align: center;
        }

        .set-card.current {
            border-color: var(--primary-red);
            background: rgba(178, 34, 34, 0.05);
        }

        .set-card.completed {
            background: var(--light-gray);
        }

        .set-number {
            font-size: 0.9rem;
            color: var(--gray);
            margin-bottom: 8px;
        }

        .set-score {
            font-size: 1.1rem;
            font-weight: 600;
            color: var(--dark-gray);
        }

        .game-controls {
            display: flex;
            gap: 15px;
            justify-content: center;
            flex-wrap: wrap;
        }

        .btn {
            padding: 12px 24px;
            border: none;
            border-radius: var(--border-radius);
            cursor: pointer;
            font-weight: 600;
            transition: var(--transition);
            font-size: 1rem;
        }

        .btn-success {
            background: var(--success);
            color: var(--white);
        }

        .btn-success:hover {
            background: #218838;
            transform: translateY(-2px);
        }

        .btn-warning {
            background: var(--warning);
            color: var(--dark-gray);
        }

        .btn-warning:hover {
            background: #e0a800;
            transform: translateY(-2px);
        }

        .btn-danger {
            background: var(--danger);
            color: var(--white);
        }

        .btn-danger:hover {
            background: #c82333;
            transform: translateY(-2px);
        }

        .btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
            transform: none !important;
        }

        /* Responsive */
        @media (max-width: 768px) {
            .header-content {
                flex-direction: column;
                gap: 15px;
                text-align: center;
            }

            .players-container {
                grid-template-columns: 1fr;
                gap: 20px;
            }

            .vs-divider {
                order: 2;
                font-size: 2rem;
            }

            .player-card:nth-child(1) { order: 1; }
            .player-card:nth-child(3) { order: 3; }

            .score-controls {
                flex-direction: row;
            }

            .game-controls {
                flex-direction: column;
            }

            .btn {
                width: 100%;
            }
        }

        /* Animations */
        @keyframes servicePulse {
            0% { opacity: 0.7; transform: scale(1); }
            50% { opacity: 1; transform: scale(1.1); }
            100% { opacity: 0.7; transform: scale(1); }
        }

        @keyframes scoreBounce {
            0% { transform: scale(1); }
            50% { transform: scale(1.2); }
            100% { transform: scale(1); }
        }
    </style>
</head>
<body>
    <!-- Header -->
    <div class="header">
        <div class="header-content">
            <button class="back-btn" onclick="history.back()">
                <i class="fas fa-arrow-left"></i>
                Back to Match
            </button>
            
            <div class="match-title">
                <div class="match-number">Match <%= currentMatch.matchId %></div>
                <div class="match-type"><%= currentMatch.type.charAt(0).toUpperCase() + currentMatch.type.slice(1) %></div>
            </div>
            
            <div></div> <!-- Spacer -->
        </div>
    </div>

    <!-- Content -->
    <div class="content">
        <div class="scorecard">
            <!-- Match Info -->
            <div class="match-info">
                <div class="info-item">
                    <div class="info-label">Court</div>
                    <div class="info-value" id="court-info"><%= currentMatch.courtNumber %></div>
                </div>
                <div class="info-item">
                    <div class="info-label">Max Points</div>
                    <div class="info-value" id="max-points"><%= currentMatch.maxPoints %></div>
                </div>
                <div class="info-item">
                    <div class="info-label">Sets</div>
                    <div class="info-value" id="total-sets"><%= currentMatch.numberOfSets %></div>
                </div>
                <div class="info-item">
                    <div class="info-label">Current Set</div>
                    <div class="info-value" id="current-set">1</div>
                </div>
            </div>

            <!-- Players Section -->
            <div class="players-section">
                <!-- Game Status -->
                <div class="game-status" id="game-status">
                    <!-- Status messages will appear here -->
                </div>

                <!-- Players Container -->
                <div class="players-container">
                    <!-- Player/Team 1 -->
                    <div class="player-card" id="player1-card">
                        <div class="service-indicator" id="player1-service" style="display: none;">
                            <i class="fas fa-circle"></i>
                        </div>
                        <div class="player-name" id="player1-name">
                            <% if (currentMatch.type === 'singles') { %>
                                <%= currentMatch.player1Name %>
                            <% } else { %>
                                <%= currentMatch.team1Player1Name %><br>
                                <small><%= currentMatch.team1Player2Name %></small>
                            <% } %>
                        </div>
                        <div class="player-score" id="player1-score">0</div>
                        <div class="score-controls">
                            <button class="score-btn" id="player1-minus">
                                <i class="fas fa-minus"></i>
                            </button>
                            <button class="score-btn" id="player1-plus">
                                <i class="fas fa-plus"></i>
                            </button>
                        </div>
                    </div>

                    <div class="vs-divider">VS</div>

                    <!-- Player/Team 2 -->
                    <div class="player-card" id="player2-card">
                        <div class="service-indicator" id="player2-service" style="display: none;">
                            <i class="fas fa-circle"></i>
                        </div>
                        <div class="player-name" id="player2-name">
                            <% if (currentMatch.type === 'singles') { %>
                                <%= currentMatch.player2Name %>
                            <% } else { %>
                                <%= currentMatch.team2Player1Name %><br>
                                <small><%= currentMatch.team2Player2Name %></small>
                            <% } %>
                        </div>
                        <div class="player-score" id="player2-score">0</div>
                        <div class="score-controls">
                            <button class="score-btn" id="player2-minus">
                                <i class="fas fa-minus"></i>
                            </button>
                            <button class="score-btn" id="player2-plus">
                                <i class="fas fa-plus"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Sets Section -->
                <div class="sets-section">
                    <div class="sets-title">Sets Progress</div>
                    <div class="sets-grid" id="sets-grid">
                        <!-- Set cards will be generated here -->
                    </div>
                </div>

                <!-- Game Controls -->
                <div class="game-controls">
                    <button class="btn btn-warning" id="timeout-btn">
                        <i class="fas fa-pause"></i>
                        Timeout
                    </button>
                    <button class="btn btn-success" id="next-set-btn" style="display: none;">
                        <i class="fas fa-forward"></i>
                        Next Set
                    </button>
                    <button class="btn btn-success" id="finish-match-btn" style="display: none;">
                        <i class="fas fa-trophy"></i>
                        Finish Match
                    </button>
                    <button class="btn btn-danger" id="end-match-btn">
                        <i class="fas fa-stop"></i>
                        End Match
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Scorecard data from server
        const matchConfig = {
            type: "<%= currentMatch.type %>",
            matchId: "<%= currentMatch.matchId %>",
            mainMatchId: "<%= currentMatch.mainMatchId %>",
            maxPoints: "<%= currentMatch.maxPoints %>",
            numberOfSets: "<%= currentMatch.numberOfSets %>",
            courtNumber: "<%= currentMatch.courtNumber %>",
            firstServer: "<%= currentMatch.firstServer %>"
        };

        // Game state
        let gameState = {
            currentSet: 1,
            maxPoints: matchConfig.maxPoints,
            numberOfSets: matchConfig.numberOfSets,
            player1Score: 0,
            player2Score: 0,
            player1Sets: 0,
            player2Sets: 0,
            sets: [],
            servingPlayer: matchConfig.firstServer === 'team1' ? 1 : 2,
            gameOver: false,
            advantage: null // null, 1, or 2
        };

        // Initialize scorecard
        function initializeScorecard() {
            updateServingIndicator();
            generateSetsGrid();
            updateGameStatus();
            setupEventListeners();
        }

        // Setup event listeners
        function setupEventListeners() {
            // Score buttons
            document.getElementById('player1-plus').addEventListener('click', () => addScore(1));
            document.getElementById('player1-minus').addEventListener('click', () => subtractScore(1));
            document.getElementById('player2-plus').addEventListener('click', () => addScore(2));
            document.getElementById('player2-minus').addEventListener('click', () => subtractScore(2));

            // Control buttons
            document.getElementById('next-set-btn').addEventListener('click', startNextSet);
            document.getElementById('finish-match-btn').addEventListener('click', finishMatch);
            document.getElementById('end-match-btn').addEventListener('click', endMatch);
            document.getElementById('timeout-btn').addEventListener('click', takeTimeout);
        }

        // Add score to player
        function addScore(player) {
            if (gameState.gameOver) return;

            if (player === 1) {
                gameState.player1Score++;
                document.getElementById('player1-score').textContent = gameState.player1Score;
                animateScore('player1-score');
            } else {
                gameState.player2Score++;
                document.getElementById('player2-score').textContent = gameState.player2Score;
                animateScore('player2-score');
            }

            // Switch serving player
            gameState.servingPlayer = gameState.servingPlayer === 1 ? 2 : 1;
            updateServingIndicator();

            // Check for set/match win
            checkSetWin();
            updateGameStatus();
        }

        // Subtract score from player
        function subtractScore(player) {
            if (gameState.gameOver) return;

            if (player === 1 && gameState.player1Score > 0) {
                gameState.player1Score--;
                document.getElementById('player1-score').textContent = gameState.player1Score;
            } else if (player === 2 && gameState.player2Score > 0) {
                gameState.player2Score--;
                document.getElementById('player2-score').textContent = gameState.player2Score;
            }

            updateGameStatus();
        }

        // Animate score change
        function animateScore(elementId) {
            const element = document.getElementById(elementId);
            element.classList.add('score-change');
            setTimeout(() => {
                element.classList.remove('score-change');
            }, 500);
        }

        // Update serving indicator
        function updateServingIndicator() {
            const player1Service = document.getElementById('player1-service');
            const player2Service = document.getElementById('player2-service');
            const player1Card = document.getElementById('player1-card');
            const player2Card = document.getElementById('player2-card');

            if (gameState.servingPlayer === 1) {
                player1Service.style.display = 'flex';
                player2Service.style.display = 'none';
                player1Card.classList.add('active');
                player2Card.classList.remove('active');
            } else {
                player1Service.style.display = 'none';
                player2Service.style.display = 'flex';
                player1Card.classList.remove('active');
                player2Card.classList.add('active');
            }
        }

        // Check for set win
        function checkSetWin() {
            const p1Score = gameState.player1Score;
            const p2Score = gameState.player2Score;
            const maxPoints = gameState.maxPoints;

            // Check for normal win condition
            if ((p1Score >= maxPoints || p2Score >= maxPoints) && Math.abs(p1Score - p2Score) >= 2) {
                const winner = p1Score > p2Score ? 1 : 2;
                winSet(winner);
                return;
            }

            // Check for deuce/advantage situation
            if (p1Score >= maxPoints - 1 && p2Score >= maxPoints - 1) {
                if (Math.abs(p1Score - p2Score) === 1) {
                    gameState.advantage = p1Score > p2Score ? 1 : 2;
                } else if (Math.abs(p1Score - p2Score) === 0) {
                    gameState.advantage = null;
                }

                // If lead is 2 points after deuce, set is won
                if (Math.abs(p1Score - p2Score) >= 2) {
                    const winner = p1Score > p2Score ? 1 : 2;
                    winSet(winner);
                }
            } else {
                gameState.advantage = null;
            }
        }

        // Win a set
        function winSet(winner) {
            // Record the set
            gameState.sets.push({
                setNumber: gameState.currentSet,
                player1Score: gameState.player1Score,
                player2Score: gameState.player2Score,
                winner: winner
            });

            if (winner === 1) {
                gameState.player1Sets++;
            } else {
                gameState.player2Sets++;
            }

            updateSetsGrid();

            // Check if match is won
            const setsToWin = Math.ceil(gameState.numberOfSets / 2);
            if (gameState.player1Sets >= setsToWin || gameState.player2Sets >= setsToWin) {
                gameState.gameOver = true;
                document.getElementById('finish-match-btn').style.display = 'inline-block';
                updateGameStatus();
            } else {
                // Show next set button
                document.getElementById('next-set-btn').style.display = 'inline-block';
            }

            // Disable score buttons
            document.querySelectorAll('.score-btn').forEach(btn => {
                btn.disabled = true;
            });
        }

        // Start next set
        function startNextSet() {
            gameState.currentSet++;
            gameState.player1Score = 0;
            gameState.player2Score = 0;
            gameState.advantage = null;

            // Alternate first server
            gameState.servingPlayer = gameState.servingPlayer === 1 ? 2 : 1;

            // Update display
            document.getElementById('player1-score').textContent = '0';
            document.getElementById('player2-score').textContent = '0';
            document.getElementById('current-set').textContent = gameState.currentSet;

            updateServingIndicator();
            updateSetsGrid();
            updateGameStatus();

            // Hide next set button and re-enable score buttons
            document.getElementById('next-set-btn').style.display = 'none';
            document.querySelectorAll('.score-btn').forEach(btn => {
                btn.disabled = false;
            });
        }

        // Generate sets grid
        function generateSetsGrid() {
            const setsGrid = document.getElementById('sets-grid');
            setsGrid.innerHTML = '';

            for (let i = 1; i <= gameState.numberOfSets; i++) {
                const setCard = document.createElement('div');
                setCard.className = 'set-card';
                setCard.id = `set-${i}`;

                if (i === gameState.currentSet && !gameState.gameOver) {
                    setCard.classList.add('current');
                } else if (i < gameState.currentSet) {
                    setCard.classList.add('completed');
                }

                setCard.innerHTML = `
                    <div class="set-number">Set ${i}</div>
                    <div class="set-score" id="set-${i}-score">-</div>
                `;

                setsGrid.appendChild(setCard);
            }

            updateSetsGrid();
        }

        // Update sets grid
        function updateSetsGrid() {
            gameState.sets.forEach((set, index) => {
                const setScoreElement = document.getElementById(`set-${set.setNumber}-score`);
                if (setScoreElement) {
                    setScoreElement.textContent = `${set.player1Score}-${set.player2Score}`;
                }
            });
        }

        // Update game status
        function updateGameStatus() {
            const statusElement = document.getElementById('game-status');
            
            if (gameState.gameOver) {
                const winner = gameState.player1Sets > gameState.player2Sets ? 1 : 2;
                const winnerName = winner === 1 ? 
                    document.getElementById('player1-name').textContent.trim() : 
                    document.getElementById('player2-name').textContent.trim();
                
                statusElement.innerHTML = `
                    <div class="status-message match-complete">
                        <i class="fas fa-trophy"></i>
                        Match completed! Winner: ${winnerName}
                    </div>
                `;
            } else if (gameState.advantage) {
                const advantagePlayer = gameState.advantage === 1 ? 
                    document.getElementById('player1-name').textContent.trim() : 
                    document.getElementById('player2-name').textContent.trim();
                
                statusElement.innerHTML = `
                    <div class="status-message advantage">
                        <i class="fas fa-star"></i>
                        Advantage: ${advantagePlayer}
                    </div>
                `;
            } else {
                statusElement.innerHTML = '';
            }
        }

        // Take timeout
        function takeTimeout() {
            alert('Timeout called! Match paused.');
        }

        // Finish match
        async function finishMatch() {
            if (confirm('Are you sure you want to finish this match?')) {
                try {
                    const winner = gameState.player1Sets > gameState.player2Sets ? 1 : 2;
                    const winnerData = {
                        email: winner === 1 ? 'team1' : 'team2',
                        name: winner === 1 ? 
                            document.getElementById('player1-name').textContent.trim() : 
                            document.getElementById('player2-name').textContent.trim()
                    };

                    const response = await fetch('/referee/update-score', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            setData: {
                                player1Score: gameState.player1Score,
                                player2Score: gameState.player2Score,
                                winnerEmail: winnerData.email,
                                lastServer: gameState.servingPlayer === 1 ? 'player1' : 'player2'
                            },
                            matchComplete: true,
                            winner: winnerData
                        })
                    });

                    const result = await response.json();
                    
                    if (result.success) {
                        alert('Match completed successfully!');
                        window.location.href = '/referee/dashboard';
                    } else {
                        alert('Error completing match: ' + result.message);
                    }
                } catch (error) {
                    console.error('Error finishing match:', error);
                    alert('Error finishing match');
                }
            }
        }

        // End match early
        function endMatch() {
            if (confirm('Are you sure you want to end this match? This will return you to the dashboard.')) {
                window.location.href = '/referee/dashboard';
            }
        }

        // Initialize when page loads
        document.addEventListener('DOMContentLoaded', () => {
            initializeScorecard();
        });
    </script>
</body>
</html>