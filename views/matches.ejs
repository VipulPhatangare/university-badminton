<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Badminton Matches - Inter Collegiate Badminton Competition</title>
    <link rel="icon" type="image/png" href="/assets/shuttlecock-favicon.png">
    <link rel="stylesheet" href="/css/matches.css">
</head>
<body>
    
    
    <div class="container">
        <!-- View 1: Matches List -->
        <div id="matchesListView" class="view active">
            <!-- Header -->
            <header class="header">
                <h1>University Badminton Matches</h1>
            </header>

            <!-- Navigation Bar with Back Button and Search -->
            <nav class="search-navbar">
                <div class="nav-header">
                    <button class="back-to-home-btn" onclick="goToHomepage()">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M19 12H5M12 19l-7-7 7-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                        Back to Home
                    </button>
                </div>
                
                <div class="search-container">
                    <div class="search-box">
                        <input type="text" id="searchInput" placeholder="Search matches, teams, players..." class="search-input">
                        <button class="search-btn" id="searchBtn">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <circle cx="11" cy="11" r="8" stroke="currentColor" stroke-width="2"/>
                                <path d="m21 21-4.35-4.35" stroke="currentColor" stroke-width="2"/>
                            </svg>
                        </button>
                        <button class="clear-search-btn" id="clearSearchBtn" style="display: none;">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <line x1="18" y1="6" x2="6" y2="18" stroke="currentColor" stroke-width="2"/>
                                <line x1="6" y1="6" x2="18" y2="18" stroke="currentColor" stroke-width="2"/>
                            </svg>
                        </button>
                    </div>
                    
                    <div class="search-filters">
                        <select id="roundFilter" class="filter-select">
                            <option value="">All Rounds</option>
                            <option value="round_1">Round 1</option>
                            <option value="round_2">Round 2</option>
                            <option value="quarter">Quarter Final</option>
                            <option value="semi">Semi Final</option>
                            <option value="final">Final</option>
                        </select>
                        
                        <button class="reset-filters-btn" id="resetFiltersBtn">Reset Filters</button>
                    </div>
                </div>
                
                <!-- Search Results Info -->
                <div class="search-results-info" id="searchResultsInfo" style="display: none;">
                    <span id="resultsCount">0</span> matches found
                    <span id="searchQuery"></span>
                </div>
            </nav>

            <!-- Gender Toggle -->
            <div class="gender-toggle-section">
                <button class="gender-toggle-btn active" id="boysToggle" onclick="selectGender('boys')">
                    Boys Matches
                </button>
                <button class="gender-toggle-btn" id="girlsToggle" onclick="selectGender('girls')">
                    Girls Matches
                </button>
            </div>

            <!-- Filter Tabs -->
            <div class="filter-section">
                <div class="filter-tabs">
                    <button class="tab-btn active" data-filter="all">All</button>
                    <button class="tab-btn" data-filter="live">Live</button>
                    <button class="tab-btn" data-filter="upcoming">Upcoming</button>
                    <button class="tab-btn" data-filter="complete">Complete</button>
                </div>
            </div>

            <!-- Matches Container -->
            <div class="matches-container" id="matchesContainer">
                <!-- Match cards will be dynamically loaded here -->
            </div>

            <!-- Loading Spinner -->
            <div class="loading" id="loading">
                <div class="spinner"></div>
                <p>Loading matches...</p>
            </div>

            <!-- No Matches Message -->
            <div class="no-matches" id="noMatches" style="display: none;">
                <p>No matches found</p>
            </div>
        </div>

        <!-- View 2: Match Detail (Submatches List) -->
        <div id="matchDetailView" class="view">
            <!-- Back Button -->
            <button class="back-btn" onclick="showMatchesList()">
                ← Back to Matches
            </button>

            <!-- Match Header -->
            <div class="match-header" id="matchHeader">
                <!-- Will be dynamically populated -->
            </div>

            <!-- Overall Score -->
            <div id="overallScoreContainer"></div>

            <!-- Sub-matches Container -->
            <div class="submatches-container" id="submatchesContainer">
                <!-- Singles and Doubles matches will be listed here -->
            </div>
        </div>

        <!-- View 3: Submatch Detail -->
        <div id="submatchDetailView" class="view">
            <!-- Back Button -->
            <button class="back-btn" onclick="goBackToMatchDetail()">
                ← Back to Match
            </button>

            <!-- Match Info Header -->
            <div class="match-info" id="matchInfo">
                <!-- Match info will be populated here -->
            </div>

            <!-- Score Section -->
            <div class="score-section" id="scoreSection">
                <!-- Score cards will be displayed here -->
            </div>

            <!-- Tabs -->
            <div class="tabs">
                <button class="tab-btn-detail active" data-tab="summary">SUMMARY</button>
                <button class="tab-btn-detail" data-tab="history">MATCH HISTORY</button>
            </div>

            <!-- Tab Content -->
            <div class="tab-content">
                <!-- Summary Tab -->
                <div class="tab-pane active" id="summaryTab">
                    <div class="score-table" id="scoreTable">
                        <!-- Score summary will be displayed here -->
                    </div>
                </div>

                <!-- Match History Tab -->
                <div class="tab-pane" id="historyTab">
                    <div class="point-history" id="pointHistory">
                        <!-- Point by point history will be displayed here -->
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="/js/matches.js"></script>
</body>
</html>
