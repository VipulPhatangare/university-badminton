<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Badminton Matches - University Tournament</title>
    <link rel="stylesheet" href="/css/matches.css">
</head>
<body>
    
    
    <div class="container">
        <!-- View 1: Matches List -->
        <div id="matchesListView" class="view active">
            <!-- Header -->
            <header class="header">
                <h1>University Badminton Matches</h1>
            </header>

            <!-- Filter Tabs with Gender Switch -->
            <div class="filter-section">
                <div class="filter-tabs">
                    <button class="tab-btn active" data-filter="all">All Matches</button>
                    <button class="tab-btn" data-filter="live">Live</button>
                    <button class="tab-btn" data-filter="upcoming">Upcoming</button>
                    <button class="tab-btn" data-filter="complete">Finished</button>
                </div>
                
                <!-- Gender Switch -->
                <div class="gender-switch-container">
                    <span class="gender-label active" id="boysLabel">Boys</span>
                    <label class="switch">
                        <input type="checkbox" id="genderSwitch" onchange="toggleGender()">
                        <span class="slider"></span>
                    </label>
                    <span class="gender-label" id="girlsLabel">Girls</span>
                </div>
            </div>

            <!-- Matches Container -->
            <div class="matches-container" id="matchesContainer">
                <!-- Match cards will be dynamically loaded here -->
            </div>

            <!-- Loading Spinner -->
            <div class="loading" id="loading">
                <div class="spinner"></div>
                <p>Loading matches...</p>
            </div>

            <!-- No Matches Message -->
            <div class="no-matches" id="noMatches" style="display: none;">
                <p>No matches found</p>
            </div>
        </div>

        <!-- View 2: Match Detail (Submatches List) -->
        <div id="matchDetailView" class="view">
            <!-- Back Button -->
            <button class="back-btn" onclick="showMatchesList()">
                ← Back to Matches
            </button>

            <!-- Match Header -->
            <div class="match-header" id="matchHeader">
                <!-- Will be dynamically populated -->
            </div>

            <!-- Overall Score -->
            <div id="overallScoreContainer"></div>

            <!-- Sub-matches Container -->
            <div class="submatches-container" id="submatchesContainer">
                <!-- Singles and Doubles matches will be listed here -->
            </div>
        </div>

        <!-- View 3: Submatch Detail -->
        <div id="submatchDetailView" class="view">
            <!-- Back Button -->
            <button class="back-btn" onclick="goBackToMatchDetail()">
                ← Back to Match
            </button>

            <!-- Match Info Header -->
            <div class="match-info" id="matchInfo">
                <!-- Match info will be populated here -->
            </div>

            <!-- Score Section -->
            <div class="score-section" id="scoreSection">
                <!-- Score cards will be displayed here -->
            </div>

            <!-- Tabs -->
            <div class="tabs">
                <button class="tab-btn-detail active" data-tab="summary">SUMMARY</button>
                <button class="tab-btn-detail" data-tab="history">MATCH HISTORY</button>
            </div>

            <!-- Tab Content -->
            <div class="tab-content">
                <!-- Summary Tab -->
                <div class="tab-pane active" id="summaryTab">
                    <div class="score-table" id="scoreTable">
                        <!-- Score summary will be displayed here -->
                    </div>
                </div>

                <!-- Match History Tab -->
                <div class="tab-pane" id="historyTab">
                    <div class="point-history" id="pointHistory">
                        <!-- Point by point history will be displayed here -->
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="/js/matches.js"></script>
</body>
</html>
